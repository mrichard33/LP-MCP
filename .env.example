# ─── Lead Perfection API (v5.0) ───────────────────────────────────
# Auth: JWT token via POST /token (expires 24hr, auto-refreshed every 23hr)
# All endpoints are POST with Content-Type: application/x-www-form-urlencoded
#
# IMPORTANT: Token is path-specific — only valid on the server it was generated on.
# Confirm which server the Reece account uses before setting LP_API_BASE_URL.

# Production server URL (one of these):
#   https://api.leadperfection.com   (Production 1 — most common)
#   https://api2.leadperfection.com  (Production 2)
#   https://api3.leadperfection.com  (Production 3)
#   https://apitest.leadperfection.com  (Test — for development only)
LP_API_BASE_URL=

# LP user account with APISECURITY permissions enabled
LP_USERNAME=

# LP user account password
LP_PASSWORD=

# Company subdomain code — NOT the username.
# If LP login URL is xx00.leadperfection.com, ClientID = xx00
LP_CLIENT_ID=

# GUID issued by RJR Technology — unique per integration
# Obtain from LP account management if not already issued
LP_APP_KEY=

# ─── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GoHighLevel ──────────────────────────────────────────────────
GHL_API_KEY=

# ─── GHL rate limiter (src/ghl-rate-limiter.js) ──────────────────
# v1.3 — quiet period with no 429 before consecutive429Cycles steps down by
# one (floor 60000). The counter drives the 5min → 10min → 15min pause
# backoff; without decay it only ever increments and pins every pause at the
# 15-minute ceiling (the 2026-08-02 47-hour agentic outage).
GHL_RATE_CYCLE_DECAY_MS=600000

# ─── Agentic reply pipeline (src/services/analysis-confirm.js) ───
# Lookback for confirming that a 'deduped' analyzer verdict corresponds to a
# real ai.analysis_completed. No such event in the window → the reply is
# retried and then handed to the durable backstop instead of being silently
# marked processed (the 2026-08-02 Engelke silent drop).
DEDUP_CONFIRM_WINDOW_MS=300000

# Agentic-silence watchdog (src/agentic-silence-alerts.js, fired from the
# decision-engine heartbeat). Pages GroupMe when the pipeline produces zero
# ai.analysis_completed while answerable replies arrive — the signal the
# 2026-08-02 47-hour outage produced and nothing watched. Replies the bot is
# deliberately silenced on (stop-bot / terminal suppression) are excluded, so a
# quiet night of DNC traffic does not page.
AGENTIC_SILENCE_WINDOW_HOURS=6
AGENTIC_SILENCE_MIN_REPLIES=2                # answerable replies needed before zero analyses pages
AGENTIC_SILENCE_ALERT_COOLDOWN_MS=21600000   # 6h — one page per window, not one per heartbeat

# ─── Canvassing Pilot v2 intake (POST /webhooks/canvassing-lead) ──
CANVASSING_WEBHOOK_SECRET=      # optional x-webhook-secret guard; route is open when unset
SALESRABBIT_API_TOKEN=          # Bearer token for PUT api.salesrabbit.com/leads/{id} — replaces the inline I.CC token (rotate at cutover)
GROUPME_CANVASS_BOT_ID=         # bot for the "Canvassing — SMS Confirmed" group; unset → falls back to GROUPME_BOT_ID
# CANVASS_PREFERRED_TIME_FIELD_ID=  # optional GHL custom-field id fallback for the conf-flow appointment time

# ─── Affiliate lead intake (POST /webhooks/affiliate-lead) ────────
# Per-affiliate GHL form → LP. Deliberately NOT the canvassing route: different
# dedup table, sender GHL-Affiliate, and a booking window sized for someone who
# sets the appointment at lead entry rather than standing at a door.
#
# ATTRIBUTION IS NOT CONFIGURED HERE. The GHL workflow sends srs_id (the LP
# SubSource ID) and affiliate_code as customData, and the handler posts what it
# is given — no registry, no allowlist. ONE SubSource PER AFFILIATE still holds;
# a shared pilot bucket cannot be split later without rewriting attribution
# history (see sql/054_consolidate_source_mappings.sql). Onboarding an affiliate
# is therefore a pure GHL change: no deploy, no env edit.
#
# The cost of that: a mistyped srs_id in a workflow misattributes silently and
# permanently — the handler cannot tell a correct SubSource ID from a plausible
# wrong one. Verify a new affiliate's FIRST live lead lands under the SubSource
# you expect before letting volume through. There is no fallback constant in the
# code, so a workflow that omits srs_id 400s rather than borrowing canvassing's.
AFFILIATE_WINDOW_DAYS=21        # booking horizon before an appointment is flagged beyond_window
AFFILIATE_DEDUP_WINDOW_MIN=1440 # 24h idempotency window on ghl_contact_id; matches canvassing
AFFILIATE_WEBHOOK_SECRET=       # optional x-webhook-secret guard; route is open when unset. RECOMMENDED — unlike the canvassing route, this endpoint is reachable by a third party's workflow
AFFILIATE_GROUPME_CHANNEL=      # optional logical card channel; unset → 'canvass' until a dedicated group exists

# ─── LP addlead proxy (src/lp-addlead-proxy.js) ───────────────────
# One synchronous hop between GHL's addlead webhooks and LP's legacy endpoint.
# It sits on the intake artery and is fail-open by contract: any validation or
# enrichment error forwards the body untouched.
LP_ADDLEAD_URL=http://lppost.leadperfection.com/br27/addlead
LP_ADDLEAD_TIMEOUT_MS=30000
# Appointment-hour validation.
#   shadow      — validate + GroupMe card, NEVER strip. Default.
#   validate    — strip adate/atime on impossible hour / blank time / blank appt_id.
#   passthrough — no validation, pure forward. The kill switch; reverts behavior
#                 without touching GHL.
LP_ADDLEAD_PROXY_MODE=shadow

# ─── Agentic lead notes (src/services/agentic-lead-notes.js) ──────
# Deterministic, code-owned call-center brief for the LP `notes` field, read
# from GHL custom fields BY ID so a slug rename cannot silently empty it. The
# brief a setter opens otherwise comes from a ChatGPT node whose prompt reads a
# field vocabulary that only partly overlaps what the agentic system writes,
# and which never references the chat transcript.
#
# SHIPS DARK: on 'shadow' the brief is built and logged
# ("[LP-PROXY] 🕶️ NOTES SHADOW ...") but nothing reaching LP changes. Read a
# few real briefs in the Railway logs before flipping this.
#   shadow  — build + log only. Default.
#   live    — replace `notes` when the incoming value is blank or weak.
#   augment — same as live when weak; when the incoming brief is HEALTHY,
#             append only the sections it lacks (transcript, objection code,
#             trust score, market) instead of replacing it. Prefer this if the
#             ChatGPT node's output is worth keeping.
#   off     — skip entirely, no GHL fetch. Kill switch.
# Rollback is setting this to 'off' (or 'shadow') and redeploying.
LP_ADDLEAD_NOTES_MODE=shadow
# Hard ceiling on the enrichment's GHL fetch. Enrichment must never be why a
# lead is slow to reach LP; at the ceiling the body forwards unchanged.
LP_NOTES_ENRICH_TIMEOUT_MS=3000
# Ceiling on the composed brief. The chat transcript is always last, so it is
# what gets trimmed first when the budget runs out.
LP_NOTES_MAX_CHARS=3500
# Briefs shorter than this (or that are only an unresolved "{{contact.x}}"
# merge token) count as weak and are eligible for replacement.
LP_NOTES_WEAK_THRESHOLD=120

# ─── GHL Inbound → LP Note pipeline (src/ghl-note-pipeline) ───────
# Turns GHL inbound conversations into one clean facts-only LP note per
# conversation session for the call center. GHL-only, independent of Revin.
# Reuses GHL_API_KEY, GHL_LOCATION_ID, HL_SUPABASE_URL/_SERVICE_ROLE_KEY,
# ANTHROPIC_API_KEY, GROUPME_BOT_ID, SUPABASE_* and LP_* creds.
WEBHOOK_GHL_INBOUND_TOKEN=         # same secret set in the GHL webhook X-Webhook-Token header
GHL_NOTE_MODE=shadow               # off | shadow | live  (deploy as shadow)
LP_NOTE_REP_ID=                    # informational AI-brief identity (AddNotes has no rep_id field)
GHL_NOTE_CATEGORY_ID=1             # LP note category (nct_id) for standard notes
GHL_NOTE_IMPORTANT_CATEGORY_ID=    # LP note category (nct_id) for important notes; blank = use standard
GHL_NOTE_DEBOUNCE_MIN=30
GHL_NOTE_SWEEP_SEC=90
GHL_NOTE_RECON_MIN=30
GHL_NOTE_STALE_CLAIM_MIN=15
GHL_NOTE_MAX_ATTEMPTS=5
GHL_NOTE_TEXT_TYPES=2,3,5,11,18,29 # allowlisted channels (GHL numeric message types)
GHL_NOTE_DROP_TYPES=1,45           # calls + reactions
# Optional per-function model override for the summarizer (default claude-sonnet-4-6):
# GHL_NOTE_SUMMARIZER_MODEL_ANTHROPIC=claude-sonnet-4-6

# ─── Lead Gurus (I.LG — paid-media ingest, src/leadgurus-ingest.js) ──
# Paid-media agency platform (clients.leadgurus.com). Header X-API-Key.
LEAD_GURUS_API_KEY=
LEAD_GURUS_CLIENT_ID=91
# Contact enrichment is OFF until all 5 GHL custom-field IDs exist AND this is
# 'true'. Leave disabled until Mark creates the ft_* fields and captures IDs.
LEAD_GURUS_ENRICH_ENABLED=false
GHL_CF_FT_CAMPAIGN_ID=
GHL_CF_FT_CREDIT_SCORE=
GHL_CF_FT_PROJECT_TYPE=
GHL_CF_FT_SELF_BOOK_DT=
GHL_CF_FT_TERRITORY=

# ─── Anthropic API (for Response Generator) ──────────────────────
# Used by src/response-generator.js to generate Antifragile responses
ANTHROPIC_API_KEY=

# ─── OpenAI API (for KB embeddings) ──────────────────────────────
# Used by src/knowledge/openai-embeddings.js for text-embedding-3-small
# Required for vector search across the kb_embeddings table.
# Cost: ~$0.02 per 1M input tokens. Each response generation = ~1 embed.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── MCP Server ───────────────────────────────────────────────────
MCP_AUTH_TOKEN=
PORT=3000

# ─── Context Builder ─────────────────────────────────────────────
# In-memory context cache TTL (ms). Default 60000 (1 min). Was 5 min.
# Lower value reduces stale-data risk when other callers hit the cache.
CONTEXT_CACHE_TTL_MS=60000

# Threshold (minutes) above which lp_lead.synced_at is flagged stale
# for active dispositions. Lower = more LP refreshes, higher = more risk.
LP_DATA_STALE_THRESHOLD_MIN=15

# ─── Infrastructure Admin (v5.1) ─────────────────────────────────
# Railway API — project-scoped token from Railway dashboard
RAILWAY_API_TOKEN=
# Railway service ID for the LP MCP service
RAILWAY_SERVICE_ID=
# GitHub PAT — repo scope on LP MCP repository
GITHUB_PAT=
# GitHub repo path (org/repo format, e.g. 'reece-windows/lp-mcp-server')
GITHUB_REPO=

# ─── Webhook (optional) ───────────────────────────────────────────
N8N_WEBHOOK_SECRET=

# ─── Agentic cooling callbacks ───────────────────────────────────
# Token used by the GHL I.COOL-* workflows when POSTing cooling callbacks
# to /agentic/cooling/complete and /agentic/cooling/error.
# Set the SAME value in GHL custom_values.message_engine_token.
# Falls back to MESSAGE_ENGINE_TOKEN if unset.
AGENTIC_CALLBACK_TOKEN=

# ─── Agentic reply dispatcher (2026-07-03 rebuild, Steve Nkzhm incident) ──
# Master switch for direct agentic sends via the GHL Conversations API with
# channel + identity inherited from the triggering inbound (Live_Chat stays
# in the widget; SMS replies from the exact number the customer texted).
# 'false' = instant rollback to the legacy relay-workflow webhook path
# (requires GHL workflow 497e664a still published). Default: true.
AGENTIC_DIRECT_SEND=true
# A livechat inbound older than this many minutes is treated as a closed
# widget session and downgraded to SMS (when the contact has a phone).
LIVECHAT_SESSION_TTL_MIN=15
# Minimum gap between agentic sends to one contact. A reply that becomes
# ready inside the gap is rescheduled and re-checks supersession first.
MIN_AGENTIC_SEND_GAP_SEC=90
# An in_flight agentic reply slot older than this is treated as a crashed
# holder and reclaimed at the next acquire.
LOCK_TTL_SEC=120

# ─── Booking offer window (v1.1 — 2026-07-24 Engelke incident) ───────
# Offered times start within the next N hours unless the lead named a specific
# farther day. The calendar FETCH stays wide (CAL_AVAIL_WINDOW_DAYS, default 14)
# so a lead-requested far date can still be matched; only the OFFER is narrowed.
BOOKING_OFFER_WINDOW_HOURS=48
# Minimum notice floor — a slot sooner than this is never offered (rep dispatch
# + drive time). CONFIRM real number with Mark/Edwin.
BOOKING_MIN_NOTICE_HOURS=4
# Escalation ladder (hours) when nothing is open in the standard window; each
# rung requires the "next two days are full" acknowledgment in the reply.
BOOKING_ESCALATION_LADDER=48,72,96,168
# GHL custom-field ids for persisting the lead's OWN stated time (fill-if-empty).
# "Preferred Estimate Time" already exists (defaulted in code). The two
# "Last Requested…" fields do NOT exist yet — Mark creates them and sets the ids
# here; until then those writes no-op.
# PREFERRED_ESTIMATE_TIME_FIELD_ID=7lpRWFDM8DZbLd3viHEG
# LAST_REQUESTED_DATE_FIELD_ID=
# LAST_REQUESTED_TIME_WINDOW_FIELD_ID=

# ─── LP Contact Auto-Create Backstop ─────────────────────────────
# Flag-gated 15-min sweep: finds-or-creates the GHL contact for unlinked LP
# leads with an upcoming Set/Cnf/Verif appointment (I.LP-IN webhook delivery
# misses ~30% of them), then reconciles the appointment. When not 'true' the
# scheduler no-ops; the admin endpoint POST /admin/lp-contact-backstop still
# works (dry-run default) for verification. Flip to true on Railway only after
# a reviewed dry-run.
ENABLE_LP_CONTACT_BACKSTOP=false
# Safety cap: max contacts created/linked per sweep run (excess carries to the
# next run — the scan self-heals as ghl_contact_id fills in).
LP_CONTACT_BACKSTOP_MAX_PER_RUN=50

# ─── Agentic Appointment Notifications (v1) ──────────────────────
# Feature flag for /api/agentic/notifications/appointment. When not
# 'true', the endpoint returns 503 and the GHL workflow's 30-min
# timeout fires the legacy fallback notification path.
ENABLE_ENHANCED_APPT_NOTIFICATIONS=false

# GHL custom field IDs for the team notification gate. Capture these
# from the GHL UI after creating the four custom fields:
#   Team Notification Body   — Multi-line text   (long-form email body)
#   Team Notification SMS    — Single-line text  (short-form SMS body)
#   Team Notification ID     — Single-line text
#   Team Notification Ready  — Single-option (Yes / No)
GHL_FIELD_TEAM_NOTIFICATION_BODY=
GHL_FIELD_TEAM_NOTIFICATION_SMS=
GHL_FIELD_TEAM_NOTIFICATION_ID=
GHL_FIELD_TEAM_NOTIFICATION_READY=

# Optional model override (defaults to claude-sonnet-4-5, falls back
# to NURTURE_GENERATOR_MODEL).
APPT_NOTIFICATION_MODEL=
APPT_NOTIFICATION_MAX_TOKENS=700
APPT_NOTIFICATION_TIMEOUT_MS=8000
APPT_NOTIFICATION_TEMPERATURE=0.4
APPT_NOTIFICATION_CONTEXT_TIMEOUT_MS=4000
APPT_NOTIFICATION_GHL_TIMEOUT_MS=10000
APPT_NOTIFICATION_EMAIL_CAP=1500
APPT_NOTIFICATION_SMS_CAP=300

# ─── Appointment / enrollment dedup (2026-07-25) ─────────────────
# Sliding window for appointment-event dedup in handleAppointment
# (src/services/appt-event-dedup.js). Dedup keys on the SLOT + last
# event type, not a status bucket, so a book→cancel→rebook still emits.
# Ignored when the webhook carries an appointment_id (permanently
# idempotent). The dedup lookup reuses EMIT_EVENT_TIMEOUT_MS as its
# per-call timeout and fails OPEN (emits) on any error.
APPT_DEDUP_WINDOW_MINUTES=60
# Window for the cross-rule enrollment guard in the action executor
# (src/services/enrollment-dedup.js): one contact must not be added to
# the same workflow twice within this many hours. Fails OPEN (enrolls).
WORKFLOW_REENROLL_WINDOW_HOURS=6

# ─── Appointment enrichment fetch (2026-07-28) ───────────────────
# fetchLatestAppointment in src/lp-appointment-sync.js called
# /calendars/events/appointments — a POST-only CREATION route — and so 404'd
# on every call since v5.1.6, leaving the calendar-name enrichment path
# dormant for months. Repointed to GET /contacts/{contactId}/appointments.
# Ships dark behind two flags; see the enable sequence below.
#
# Master gate. Anything other than 'true' → no fetch, returns null, which is
# byte-for-byte the pre-fix behaviour (calendar fields simply stay unset).
APPT_ENRICHMENT_ENABLED=false
# Shadow gate. NOTE the inverted default: anything other than the exact string
# 'false' (including UNSET) means log-only — the fetch runs and each outcome is
# recorded to system_events as appt.enrichment_fetch, but null is still
# returned, so nothing reaches the GroupMe card / GHL note / Five9 dispatch.
APPT_ENRICHMENT_LOG_ONLY=true
#
# Enable sequence — never skip a step:
#   1. Merge with both as shipped. Production behaviour unchanged.
#   2. APPT_ENRICHMENT_ENABLED=true, LOG_ONLY still true. Redeploy. The
#      repaired call now runs live but results never reach consumers.
#   3. Observe 24h: appt.enrichment_fetch should be predominantly 'ok', and
#      resolved names should match CALENDAR_NAME_MAP (short forms — "Window
#      Estimate", "MV", "HPA", "Confirmation Call", "Review Session").
#      Nulls, blanks, or unfamiliar names → STOP.
#   4. Only then APPT_ENRICHMENT_LOG_ONLY=false. This is the moment the
#      dormant path actually wakes up.
# WARNING: do NOT flip FIVE9_DIRECT_DISPATCH in the same change as step 4.
# A non-null calendarId lets isGhlOnlyCalendarId() divert Confirmation Call
# bookings past lpSetAppointment entirely (lp-appointment-sync.js).

# ─── IME MIC (Sam's Club Construction leads) ─────────────────────
# Reece is the affiliate provider for Sam's Club Construction leads.
# IME tokens expire in 30 minutes — refreshed automatically by src/ime/token-manager.js.
# All /ime/* routes use MCP_AUTH_TOKEN for auth.
IME_AFFILIATE_ID=17050371
IME_USERNAME=
IME_PASSWORD=
IME_BASE_URL_UAT=https://imewebapiexternal-uat.azurewebsites.net
IME_BASE_URL_PROD=
IME_ENV=uat                         # flip to "prod" after UAT validation
IME_TOKEN_REFRESH_BUFFER_MIN=5      # refresh 5 min before expiry
IME_RETRY_MAX=5                     # max retries per enrichment
IME_RETRY_INTERVAL_MIN=5            # retry-cron interval
IME_REQUEST_TIMEOUT_MS=15000        # per-call timeout

# ─── Map-Driven Entry Routing (routing fix, Step 2) ──────────────
# When 'true', lead entry-routing reads lp_source_mapping (granular
# source → correct entry tag + intent bucket) instead of letting the
# 6 coarse hygiene rules blanket-stamp entry:other. Gates BOTH the
# inferEntrySource Priority-0 safety net and the contact_created
# resolver. Default false = byte-for-byte current behavior.
ENTRY_RESOLVER_MAP_DRIVEN=false
# Optional: in-memory TTL (ms) for the cached lp_source_mapping table.
ENTRY_SOURCE_MAP_TTL_MS=300000

# ─── Revenue Scorecard (src/jobs/scorecard-metrics.js, goal-scorecard-daily.js) ──
# All optional — defaults below preserve current behavior. ⚠ TIE-OUT: calibrate the
# status sets against a real Reece "By Appt Date" export, then set
# SCORECARD_RECONCILED_MARKETS=REECE to flip the dashboard out of PROVISIONAL.
#
# Sold-deal job statuses RELEASED to production → counted as Net Sales.
SCORECARD_RELEASED_STATUSES=Rel To Production,RTP Await recission,RTP DP DUE,Awaiting Product
# Sold-deal job statuses HELD pre-release (financing/HOA/docs/measure) → Working Revenue.
SCORECARD_WORKING_STATUSES=HOLD - HOA,HOLD-Shutter Approval,Mgmt Hold,Awaiting Credit Application,Awaiting Lender,Awaiting Loan Docs,Awaiting Change Order,Awaiting Commission Sheet,Awaiting Paperwork,Out to Measure
# Sat dispositions EXCLUDED from the demo count (real LP labels: NOC=No Contact,
# NIS=Not Interested - Shown, 1Leg=One Leg Present — a sit, never a demo).
SCORECARD_NON_DEMO_DISPOSITIONS=NOC,NIS,1LEG
# Snapshot freshness watchdog (07:00 ET): GroupMe alert when the daily
# lp_market_scorecard_daily snapshot for the last completed selling day is
# missing. Alert-only; set true to silence.
SCORECARD_WATCHDOG_DISABLED=false
# (existing) Job statuses counted as KO / cancelled (drive the "Net" columns).
SCORECARD_CANCEL_STATUSES=Cancelled,Cancelled By Mgt,Dead Deal,Credit Decline
# (existing) Comma-separated markets confirmed reconciled → flips reconciled=true (default: none = provisional).
SCORECARD_RECONCILED_MARKETS=
# NIGHTLY live-month funnel attribution: 'true' attributes the daily scorecard
# branch-first (lp_lead_market_assignments, matching revenue); anything else (default)
# keeps the legacy prospect-ZIP attribution. OFF by default so a deploy is INERT until
# flipped — the closed-month re-derive (POST /n8n/admin/scorecard-market-rederive)
# always measures branch-first regardless of this flag, so the gate can be verified
# before the live-month behavior is switched on.
SCORECARD_BRANCH_FIRST_ATTRIBUTION=
# Selling-day calendar (src/selling-days.js) — drives days_elapsed (numerator) and
# working_days_in_period (denominator) on each snapshot. Must match the dashboard's
# SCORECARD_SELLING_DAYS / SCORECARD_HOLIDAYS so writer and reader share one basis.
SCORECARD_SELLING_DAYS=mon,tue,wed,thu,fri,sat
# Non-selling days: comma-separated YYYY-MM-DD, or "none". Default (empty) = the
# eight Reece closures — New Year's, Memorial Day, Independence Day, Labor Day,
# Thanksgiving, the day after, Christmas Eve, Christmas Day — with fixed dates
# shifted to the nearest weekday when they fall on a weekend. NOT the federal
# calendar: Juneteenth, Columbus and Veterans Day stay selling days.
# Leaving this empty is the norm; the built-in list is kept identical to the
# dashboard's lib/date/holidays.ts, so the two agree without any env coordination.
SCORECARD_HOLIDAYS=

# ─── Appointment Capacity Board (src/jobs/capacity-sweep.js, sql/043) ──────
# 15-min sweep: GetSalesSchedule denominator + forward-window lead disposition
# re-sweep + forward market assignments. Nightly 23:50 ET fill snapshot.
# All optional — defaults shown.
CAPACITY_SWEEP_INTERVAL_MS=900000
CAPACITY_FORWARD_DAYS=14
# Dispositions that count as CONFIRMED (Mark: Confirmed = Cnf + Verif; Set
# does NOT count — unconfirmed appointments don't run). The explicit GetLead
# confirmed boolean (lp_leads.appointment_confirmed) is preferred when present;
# these codes are the fallback for rows synced before that column existed.
CAPACITY_CONFIRMED_CODES=Cnf,Issue
# Dispositions excluded from confirmed AND set_pending (still counted in appts).
CAPACITY_EXCLUDED_CODES=CXL,DNC
# Near-window full refresh: appointments today..today+N days ET are re-fetched
# PER LEAD every sweep (exact counts for the dates the board is for, immune to
# LP change-window semantics). ~100-200 GetLead calls per sweep at N=2.
CAPACITY_NEAR_DAYS=2
# At-risk bucket (set-but-not-confirmed; rendered as the red "at risk" count).
CAPACITY_AT_RISK_CODES=Set,Verif
# Pause between continuous lead-pass cycles (near-window refresh + change
# window). The fast pass (slots + assignments) runs on CAPACITY_SWEEP_INTERVAL_MS.
CAPACITY_LEAD_LOOP_PAUSE_MS=60000
# Change-window page size. GetLead rows are huge full prospect records; LP's
# server 500s assembling heavy pages at deep offsets (observed truncation at
# row ~199 with PageSize 200). Keep small so every page is servable.
CAPACITY_LEAD_PAGE_SIZE=50
CAPACITY_LEAD_MAX_PAGES=80
# Change-window lookback days (before today ET). 3 self-heals recent sync
# drops; raise temporarily (e.g. 14) to recover older ones.
CAPACITY_CHANGE_BACK_DAYS=3

# ─── Band-level capacity diagnostic (src/jobs/capacity-bands.js, sql/048) ──
# Read-only: GET /admin/capacity-bands + the get_capacity_vs_ghl MCP tool.
# Reconciles GHL bookings against LP per-band rep availability (slot_id
# 1=Morning, 2=Afternoon, 3=Evening). All optional — defaults shown.
#
# Band cut points: the LAST minute of Morning and of Afternoon, ET, 24h.
# These are LP's own TmsTime markers. Verified against live GHL bookings:
# 10:00 → M, 14:00 → A, 18:00/18:30/19:00 → E (one LP evening slot per rep).
# A single source of truth — both the JS mapping and the SQL CASE derive from
# it, so a band shift is an env flip. Malformed values warn and fall back.
# Per-market cuts are NOT supported; if evening starts earlier in some markets
# this has to become per-market rather than global.
CAPACITY_BAND_CUTS=12:59,16:59
# GHL statuses that OCCUPY a slot. 'cancelled' is reported separately and never
# counted as booked. Anything outside this list stays visible via ghl_total.
CAPACITY_BAND_GHL_STATUSES=new,confirmed,showed,noshow
# Fraction of band capacity at which a row is reported TIGHT (below OVERSOLD).
CAPACITY_BAND_TIGHT_RATIO=0.8
# Default forward window when end_date is omitted.
CAPACITY_BAND_FORWARD_DAYS=14
# Hard cap on the requested window. The GHL-side ET date predicate is
# non-sargable, so an unbounded window scans a table shared with HL MCP.
CAPACITY_BAND_MAX_WINDOW_DAYS=60
# Default GHL calendar (Window Estimate).
CAPACITY_BAND_CALENDAR_ID=aJj14ONxh1oFyDcQ706O
# NOTE: GHL booking counts come from the HL MCP Supabase, so this diagnostic
# also needs HL_SUPABASE_URL + HL_SUPABASE_SERVICE_ROLE_KEY (see the HL
# fallback section). Without them the route still returns LP-side capacity with
# degraded:true rather than failing.

# Mirror-backfill page size — LP returns empty/500 for big pages at deep
# offsets; keep small so every page is servable.
LP_MIRROR_PAGE_SIZE=50

# ─── Incremental sync paging (src/sync-engine.js) ──────────────────────────
# GetLead rows are huge full prospect records; LP errors or returns EMPTY for
# big pages at deep offsets (indistinguishable from scan completion). Keep
# pages small so every page is servable; failed pages retry smaller and log
# TRUNCATED loudly instead of ending the sweep silently.
SYNC_PAGE_SIZE=50

# ─── GHL slot uniqueness + delegated booking (src/appointments/) ───────────
# Two systems create GHL appointments and neither asked GHL whether the slot
# was already taken: LP MCP via the API (createdBy.source = third_party) and
# the GHL workflow I.LP-IN via native booking nodes (source = workflow, and
# every one of those nodes sets ignoreFreeSlots:true). Measured over 60 days on
# the three estimate calendars, 619 of 5,182 slots held more than one
# appointment and 400 of those were MIXED — one from each writer — so fixing a
# single writer leaves ~two thirds of the problem in place.
#
# Master switch. SHIPS DARK: every call site falls through to its previous
# behaviour unless this is exactly 'true'. Rollback is setting it back to false
# and redeploying; the endpoint stays live and harmless (it 503s while off).
APPT_SLOT_CHECK_ENABLED=false
# Start times within this many seconds of each other are treated as the same
# slot. Compared on absolute instants (epoch ms), never wall-clock strings —
# GHL returns ISO with an offset.
APPT_SLOT_MATCH_WINDOW_S=60
# Shared key for POST /webhook/ghl/create-appointment-from-lp, sent as the
# x-appt-booking-key header. Constant-time compare, FAIL CLOSED: while this is
# unset the endpoint accepts nothing. Generate a random value per environment.
APPT_BOOKING_ENDPOINT_KEY=

# ─── Contact-scoped appointment authority (2026-08-03) ─────────────────────
# Exactly ONE LP lead may drive a GHL contact's appointment at a time
# (src/services/contact-appointment-authority.js). Appointment authority used
# to be scoped per LEAD, so any of a contact's sibling leads could drive its
# single appointment object: on 2026-08-02 three leads on prospect 449759 did,
# inside 100 minutes, and the customer was texted a time nobody agreed to.
#
# Master switch. SHIPS DARK: every call site falls through to its previous
# behaviour unless this is exactly 'true'. While off, claims are still recorded
# and appointment.authority_denied is still emitted, so the denial set can be
# sized before anything is blocked:
#   SELECT payload->>'reason', payload->>'enforced', count(*)
#   FROM system_events WHERE event_type='appointment.authority_denied' GROUP BY 1,2;
# Do not flip this until the authority_unavailable rate is zero — that reason
# means the claim is failing on infra, not on arbitration.
# Rollback is setting it back to false and redeploying.
APPT_AUTHORITY_ENFORCE=false
# Ownership starvation release. If the owning lead's LP row (updated_at_lp)
# has not been touched in this many days, a live sibling may take the seat —
# otherwise a wedged owner would hold a contact forever, since an authority row
# existing at all closes the first-writer path.
APPT_AUTHORITY_STALE_DAYS=14

# ─── Action executor watchdog (src/actions/index.js) ───────────────────────
# Per-handler watchdog ceiling for set_lp_appointment ONLY. That handler runs
# the five-step LP lead-resolution chain, then LP SetAppointment, and on a miss
# a GHL workflow enrollment — each leg with its own rate-limiter wait, so the
# 60s global ceiling (EXECUTOR_HANDLER_TIMEOUT_MS) sits below its honest worst
# case and fires on healthy-but-queued calls. Never resolves BELOW the global
# ceiling. The 10-min stuck-action reaper is still the real backstop.
EXECUTOR_LP_APPOINTMENT_TIMEOUT_MS=120000

# ─── LP scheduled-report PDF ingestion (src/jobs/lp-report-*.js) ────────────
# Optional shared secret for POST /n8n/admin/lp-report-ingest/*. When set, the
# request must carry it in x-ghl-signature (n8n sends $env.LP_WEBHOOK_SIGNATURE
# — set this to the same value). Unset = open route (house default).
LP_REPORT_INGEST_SECRET=
# Kill switch for the 07:30 ET missing-report watchdog (set to any value).
LP_REPORT_WATCHDOG_DISABLED=
# Daily 07:00 ET cross-source reconciliation. Default on; set to 'false' to skip.
LP_REPORT_RECON_ENABLED=true

# ─── Five9 gated admin writes (src/five9/admin-writes.js) ──────────────────
# Master flag. Unset or anything other than 'true' = DRY-RUN: every guardrail,
# read-before-write and SOAP body build still runs, the envelope is logged, but
# no mutation is sent. Arming this is a deliberate, separate decision.
FIVE9_WRITES_ENABLED=
# Ceiling on campaign-profile numberOfAttempts for gated Five9 writes.
# Same posture as the 3% abandon line: exceeding it requires an explicit
# compliance_override:true on the action payload. Live `Data Leads` profile
# was found at 100 attempts on 2026-08-05.
FIVE9_MAX_PROFILE_ATTEMPTS=12
# Floor on CRMRedialTimeout for gated Five9 outbound campaign patches, in
# SECONDS. Going below it requires compliance_override:true on the payload.
# DIAL ASAP and After DIAL ASAP both sat at 2 hours (7200s), which is what put
# an hour-plus gap between a new lead's first and second call.
FIVE9_MIN_CRM_REDIAL_SEC=300
# Per-action ceiling on BULK list deletion
# (five9_async_delete_records_from_list). Above this, the action refuses
# unless the payload carries compliance_override:true, which is recorded on
# the five9.admin_write audit event. A second, independent line also refuses
# any request that would remove more than 50% of the list — that one catches
# a bad cohort query nuking the list instead of the intended subset, which
# the absolute ceiling cannot detect on its own.
FIVE9_MAX_LIST_DELETE=2000
# Fleet-wide serialization lock TTL for Five9 admin writes, in SECONDS. One
# write in flight at a time (outbound_locks key "five9_admin:write").
FIVE9_WRITE_LOCK_TTL_SEC=120

# ─── Five9 config snapshot + change log (src/jobs/five9-config-snapshot.js) ──
# Daily point-in-time record of every Five9 configuration object, plus a
# field-level change log. Read-only — never repairs drift it finds. Ships dark.
FIVE9_CONFIG_SNAPSHOT_ENABLED=false
# ET hour for the daily run (0-23).
FIVE9_CONFIG_SNAPSHOT_HOUR_ET=4
# Delay between sequential Five9 SOAP reads during a snapshot run, in ms.
# ~30 campaigns means ~30 sequential getOutboundCampaign calls; Five9's
# concurrent admin session limits are undisclosed and we do not probe them.
FIVE9_SNAPSHOT_DELAY_MS=250
