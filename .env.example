# ─── Lead Perfection API (v5.0) ───────────────────────────────────
# Auth: JWT token via POST /token (expires 24hr, auto-refreshed every 23hr)
# All endpoints are POST with Content-Type: application/x-www-form-urlencoded
#
# IMPORTANT: Token is path-specific — only valid on the server it was generated on.
# Confirm which server the Reece account uses before setting LP_API_BASE_URL.

# Production server URL (one of these):
#   https://api.leadperfection.com   (Production 1 — most common)
#   https://api2.leadperfection.com  (Production 2)
#   https://api3.leadperfection.com  (Production 3)
#   https://apitest.leadperfection.com  (Test — for development only)
LP_API_BASE_URL=

# LP user account with APISECURITY permissions enabled
LP_USERNAME=

# LP user account password
LP_PASSWORD=

# Company subdomain code — NOT the username.
# If LP login URL is xx00.leadperfection.com, ClientID = xx00
LP_CLIENT_ID=

# GUID issued by RJR Technology — unique per integration
# Obtain from LP account management if not already issued
LP_APP_KEY=

# ─── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GoHighLevel ──────────────────────────────────────────────────
GHL_API_KEY=

# ─── GHL rate limiter (src/ghl-rate-limiter.js) ──────────────────
# v1.3 — quiet period with no 429 before consecutive429Cycles steps down by
# one (floor 60000). The counter drives the 5min → 10min → 15min pause
# backoff; without decay it only ever increments and pins every pause at the
# 15-minute ceiling (the 2026-08-02 47-hour agentic outage).
GHL_RATE_CYCLE_DECAY_MS=600000

# Per-call cap on the rate-limiter queue wait for the GHL calls
# executeBookAppointment owns (the create POST, the read-back GET, and the
# title read). Default 8000ms.
#
# WHY: the limiter's default wait is 30s (RATE_LIMITER_WAIT_TIMEOUT_MS) and the
# executor kills a handler at EXECUTOR_HANDLER_TIMEOUT_MS (60s). A single 429
# drains the bucket for 5 minutes, so two sequential 30s waits are enough to
# blow the watchdog and fail a booking that was otherwise fine. Observed live
# 2026-08-16: one 429 put the bucket in a pause, a booking spent ~54s reaching
# its POST, and the handler was killed at 60s.
#
# The limiter FAILS OPEN at the cap, so a shorter wait never drops a call — it
# just stops queueing sooner. Raise this if bookings start failing open under
# normal (unpaused) load; lower it if the 60s watchdog is still being hit.
# An unparseable value falls back to 8000; the floor is 1000.
BOOKING_TOKEN_WAIT_MS=8000

# ─── One appointment per lead (2026-08-17, owner rule) ────────────
# A lead never holds more than ONE active appointment at a time.
#
# executeBookAppointment's double-book guard was CALENDAR-scoped, so a contact
# could hold one active appointment per calendar and still pass it. Verified
# live: contact mcZ8OFDfZndBUgEdcnO2 held a Confirmation Call at 1:00 PM, a
# Window Estimate at 3:00 PM and a Measurement Verification at 3:00 PM on
# 2026-07-24 — all active, none visible to the old guard.
#
# With this ON (default), a booking request for a contact that already holds an
# active appointment on a DIFFERENT calendar is REFUSED: nothing is created,
# the existing appointment is untouched, the contact is tagged
# booking:blocked-existing-appointment, booking.blocked_existing_appointment is
# emitted, and a rep task explains that the existing appointment must be
# cancelled first. Same-calendar behaviour is unchanged (idempotent skip, or
# reschedule in place — neither creates a second object).
#
# BLOCK, never replace: cancel-and-recreate would let a 15-minute Confirmation
# Call destroy a booked in-home Window Estimate. A human decides which survives.
#
# Set to 'false' to restore the old calendar-scoped behaviour without a deploy
# if this turns out to block a legitimate flow.
#
# NOTE: this only governs appointments LP-MCP creates. GHL workflows write to
# the calendar directly and cannot be gated from here — see contact
# YYtVxZwWS6gFPvajDZfY, whose duplicate pair was created one by a workflow and
# one by a third-party integration, with no agent_action involved.
ONE_APPT_PER_CONTACT=true

# ─── Agentic reply pipeline (src/services/analysis-confirm.js) ───
# Lookback for confirming that a 'deduped' analyzer verdict corresponds to a
# real ai.analysis_completed. No such event in the window → the reply is
# retried and then handed to the durable backstop instead of being silently
# marked processed (the 2026-08-02 Engelke silent drop).
DEDUP_CONFIRM_WINDOW_MS=300000

# Agentic-silence watchdog (src/agentic-silence-alerts.js, fired from the
# decision-engine heartbeat). Pages GroupMe when the pipeline produces zero
# ai.analysis_completed while answerable replies arrive — the signal the
# 2026-08-02 47-hour outage produced and nothing watched. Replies the bot is
# deliberately silenced on (stop-bot / terminal suppression) are excluded, so a
# quiet night of DNC traffic does not page.
AGENTIC_SILENCE_WINDOW_HOURS=6
AGENTIC_SILENCE_MIN_REPLIES=2                # answerable replies needed before zero analyses pages
AGENTIC_SILENCE_ALERT_COOLDOWN_MS=21600000   # 6h — one page per window, not one per heartbeat

# ─── GroupMe notification dedup (content backstop, v1.8) ──────────
GROUPME_DEDUP_ENABLED=true      # only the literal 'false' disables it (safe default ON)
GROUPME_DEDUP_WINDOW_MIN=60     # suppress a byte-identical card to the same channel for this many minutes

# ─── Slack notification mirror ──────────────────────────────────
# Every card that POSTs to GroupMe is also POSTed to Slack, byte-identical,
# for the GroupMe → Slack parallel-run period. Fail-silent: a Slack problem
# never delays or fails a GroupMe send. Canvass cards with a market also post
# to that market's channel, resolved from slack_channels / slack_market_slugs.
SLACK_BOT_TOKEN=                # Reece Bot xoxb token
SLACK_MIRROR_ENABLED=false      # literal 'true' enables; anything else = off
SLACK_CHANNEL_MAIN=             # #lead-intelligence — replaces the main GroupMe group
SLACK_CHANNEL_CANVASS=          # #canvass-all rollup; market channels resolved from slack_channels
SLACK_CHANNEL_OPS=              # #ops-alerts

# ─── Canvassing Pilot v2 intake (POST /webhooks/canvassing-lead) ──
CANVASSING_WEBHOOK_SECRET=      # optional x-webhook-secret guard; route is open when unset
SALESRABBIT_API_TOKEN=          # Bearer token for PUT api.salesrabbit.com/leads/{id} — replaces the inline I.CC token (rotate at cutover)
GROUPME_CANVASS_BOT_ID=         # bot for the "Canvassing — SMS Confirmed" group; unset → falls back to GROUPME_BOT_ID
# CANVASS_PREFERRED_TIME_FIELD_ID=  # optional GHL custom-field id fallback for the conf-flow appointment time

# ─── Canvass confirmation intake (POST /webhooks/canvass-confirmation) ──
# The Lightfire confirmation form (workflow U.LCF), BOTH branches through one
# endpoint. Record-only by contract: it emits canvass.confirmation_submitted
# and writes a GHL note, and never calls LP addLead on either path. A
# submission is an unverified intake record — a confirmation agent reviews it
# in P4, and LP creation happens later in a separate workflow. There is nothing
# to configure about attribution or LP here, because nothing on this path
# reaches LP.
CANVASS_CONFIRMATION_WEBHOOK_SECRET=      # optional x-webhook-secret guard; route is open when unset
CANVASS_CONFIRMATION_DEDUP_WINDOW_MIN=1440 # 24h idempotency window on ghl_contact_id; matches canvassing

# ─── Affiliate lead intake (POST /webhooks/affiliate-lead) ────────
# Per-affiliate GHL form → LP. Deliberately NOT the canvassing route: different
# dedup table, sender GHL-Affiliate, and a booking window sized for someone who
# sets the appointment at lead entry rather than standing at a door.
#
# ATTRIBUTION IS NOT CONFIGURED HERE. The GHL workflow sends srs_id (the LP
# SubSource ID) and affiliate_code as customData, and the handler posts what it
# is given — no registry, no allowlist. ONE SubSource PER AFFILIATE still holds;
# a shared pilot bucket cannot be split later without rewriting attribution
# history (see sql/054_consolidate_source_mappings.sql). Onboarding an affiliate
# is therefore a pure GHL change: no deploy, no env edit.
#
# The cost of that: a mistyped srs_id in a workflow misattributes silently and
# permanently — the handler cannot tell a correct SubSource ID from a plausible
# wrong one. Verify a new affiliate's FIRST live lead lands under the SubSource
# you expect before letting volume through. There is no fallback constant in the
# code, so a workflow that omits srs_id 400s rather than borrowing canvassing's.
AFFILIATE_WINDOW_DAYS=21        # booking horizon before an appointment is flagged beyond_window
AFFILIATE_DEDUP_WINDOW_MIN=1440 # 24h idempotency window on ghl_contact_id; matches canvassing
AFFILIATE_WEBHOOK_SECRET=       # optional x-webhook-secret guard; route is open when unset. RECOMMENDED — unlike the canvassing route, this endpoint is reachable by a third party's workflow
AFFILIATE_GROUPME_CHANNEL=      # optional logical card channel; unset → 'canvass' until a dedicated group exists

# ─── LP addlead proxy (src/lp-addlead-proxy.js) ───────────────────
# One synchronous hop between GHL's addlead webhooks and LP's legacy endpoint.
# It sits on the intake artery and is fail-open by contract: any validation or
# enrichment error forwards the body untouched.
LP_ADDLEAD_URL=http://lppost.leadperfection.com/br27/addlead
LP_ADDLEAD_TIMEOUT_MS=30000
# Appointment-hour validation.
#   shadow      — validate + GroupMe card, NEVER strip. Default.
#   validate    — strip adate/atime on impossible hour / blank time / blank appt_id.
#   passthrough — no validation, pure forward. The kill switch; reverts behavior
#                 without touching GHL.
LP_ADDLEAD_PROXY_MODE=shadow

# ─── Job-changes sweep: parent-lead self-heal (2026-09-03) ───────
# The job-changes sweep writes jobs whose STATUS changed. The leads sweep is
# independent, so a job whose parent lead never synced fails
# lp_jobs_lp_lead_id_fkey on every sweep forever, taking its milestones with it
# — the job's revenue never reaches lp_jobs and its post-sale tags never fire.
# When on, the sweep fetches that prospect from LP and runs it through the
# canonical upsertLeadOnly(), then retries the job once.
#   off    (default) never heals; the failure just logs to lp_sync_errors
#   shadow logs which parent it WOULD create; writes nothing
#   live   creates the parent lead and retries the job
# Heals ONLY on Postgres 23503 (missing parent). The heal path is DB-only —
# no GHL contact creation, no tags, no events — so it cannot reach a customer.
LP_JOB_PARENT_HEAL_MODE=off
# Per-sweep cap on heal attempts; each costs one LP GetLead call. Protects LP
# if a large backlog of missing parents ever appears at once. The remainder
# logs as usual and is retried on later sweeps.
LP_JOB_PARENT_HEAL_MAX_PER_SWEEP=25

# ─── LP addlead address gate (Section D, 2026-08-18) ─────────────
# The LP push IS the dial trigger, and LP never repairs a prospect from a
# later push — so the FIRST push must carry a complete address
# (address1/city/state/zip). Hold-and-enrich, never drop.
#   off | shadow (evaluate + log, forward everything — ship state) | enforce
LP_ADDRESS_GATE_MODE=shadow
# Retry interval + budget for held leads; retries exhausted → forward anyway
# with notes stamped "INCOMPLETE ADDRESS ON FILE" + one GroupMe alert.
LP_ADDRESS_HOLD_MINUTES=15
LP_ADDRESS_HOLD_MAX_RETRIES=5
# Chatbot-originated addlead with an incomplete address (the 08-16 failure
# mode): hold_then_forward (default) parks it; forward_then_backfill sends
# now and leaves prospect repair to the address backfill below.
LP_CHATBOT_ADDRESS_POLICY=hold_then_forward
# Prospect address backfill (D3 — UpdateProspectInfo with read-back verify).
# SHIPS UNSET (scheduler disarmed). Set true to arm the 15-min sweep.
LP_ADDRESS_BACKFILL_ENABLED=

# ─── LP attribution: setter + fallback source ids (2026-08-15) ────
# srs_id = LP SubSource (WHERE the lead came from)
# pro_id = LP Promoter employee id (WHO procured it)
# These two are trivially transposable and HAVE been transposed in production
# (GHL workflow I.CT shipped the chatbot pair as srs_id=5574&pro_id=830 —
# reversed — misrouting 670 leads; the canonical pair is srs_id=830 &
# pro_id=5574). Canonical values live in src/lp-source-ids.js — never inline
# them. Fastest way to spot a swap: SubSource ids are 3-digit, Promoter ids
# are 4-digit.
#
# The addlead key that carries the SETTER (the LP employee id credited with
# setting the appointment). setAppointment() already stamps
# LP_EMP.GHL_INTEGRATION = 5686 ("Integration, GoHighLevel"), but a lead
# created WITH its appointment through legacy addlead — the canvassing path
# and the chatbot self-heal path — passes no setter at all.
#
# SHIPS DISABLED, and must stay that way until Lead Perfection confirms the
# exact key. LP silently DROPS unrecognised addlead keys, so a guessed name
# would be a no-op that looks like a fix. Unset = today's behaviour exactly.
# Candidates to confirm with LP: setby / set_by / empid / User2.
# LP_ADDLEAD_SETTER_FIELD=
#
# Fallbacks written by src/admin/lp-force-addlead.js when a contact reaches
# workflow 8e30ff37's "Source ID and Pro ID" gate with either field empty.
# Corrected 2026-08-21. The GHL field labels are RIGHT and this block used to
# claim they were misleading — that claim was itself the transposition:
#   k6j4IBh5IejPooSCsj49  "LP Source ID"  → carries srs_id, SubSource (3-digit)
#   BbUJ6RrdTjjEqqRA8JVx  "Pro ID"        → carries pro_id, Promoter  (4-digit)
# Verified against live canvass contacts: k6j4…=344, BbUJ…=5339/2460.
# LP_FALLBACK_SOURCE_ID is DEAD as of 2026-08-15 — its live replacement is
# LP_FALLBACK_SRS_ID, which feeds k6j4…, while LP_FALLBACK_PRO_ID feeds BbUJ….
# Neither is set in Railway today; both defaults come from the registry.
# ⚠️ The two example values below were themselves swapped until 2026-08-21 —
# uncommenting them as they stood would have injected the inversion by hand.
# LP_FALLBACK_SRS_ID=830
# LP_FALLBACK_PRO_ID=5574

# ─── Agentic lead notes (src/services/agentic-lead-notes.js) ──────
# Deterministic, code-owned call-center brief for the LP `notes` field, read
# from GHL custom fields BY ID so a slug rename cannot silently empty it. The
# brief a setter opens otherwise comes from a ChatGPT node whose prompt reads a
# field vocabulary that only partly overlaps what the agentic system writes,
# and which never references the chat transcript.
#
# SHIPS DARK: on 'shadow' the brief is built and logged
# ("[LP-PROXY] 🕶️ NOTES SHADOW ...") but nothing reaching LP changes. Read a
# few real briefs in the Railway logs before flipping this.
#   shadow  — build + log only. Default.
#   live    — replace `notes` when the incoming value is blank or weak.
#   augment — same as live when weak; when the incoming brief is HEALTHY,
#             append only the sections it lacks (transcript, objection code,
#             trust score, market) instead of replacing it. Prefer this if the
#             ChatGPT node's output is worth keeping.
#   off     — skip entirely, no GHL fetch. Kill switch.
# Rollback is setting this to 'off' (or 'shadow') and redeploying.
LP_ADDLEAD_NOTES_MODE=shadow
# Hard ceiling on the enrichment's GHL fetch. Enrichment must never be why a
# lead is slow to reach LP; at the ceiling the body forwards unchanged.
LP_NOTES_ENRICH_TIMEOUT_MS=3000
# Ceiling on the composed brief. The chat transcript is always last, so it is
# what gets trimmed first when the budget runs out.
LP_NOTES_MAX_CHARS=3500
# Briefs shorter than this (or that are only an unresolved "{{contact.x}}"
# merge token) count as weak and are eligible for replacement.
LP_NOTES_WEAK_THRESHOLD=120

# ─── GHL Inbound → LP Note pipeline (src/ghl-note-pipeline) ───────
# Turns GHL inbound conversations into one clean facts-only LP note per
# conversation session for the call center. GHL-only, independent of Revin.
# Reuses GHL_API_KEY, GHL_LOCATION_ID, HL_SUPABASE_URL/_SERVICE_ROLE_KEY,
# ANTHROPIC_API_KEY, GROUPME_BOT_ID, SUPABASE_* and LP_* creds.
WEBHOOK_GHL_INBOUND_TOKEN=         # same secret set in the GHL webhook X-Webhook-Token header
GHL_NOTE_MODE=shadow               # off | shadow | live  (deploy as shadow)
LP_NOTE_REP_ID=                    # informational AI-brief identity (AddNotes has no rep_id field)
# Optional dedicated LP identity for note writes. LP attributes every write to
# the user behind the credential and AddNotes has no author field, so this is
# the only way a note reads as someone other than the primary user. BOTH halves
# are required; unset, notes are written by the primary credential exactly as
# before. Only /api/SalesApi/AddNotes uses it — reads, appointment sync, lead
# creation and the mirror always stay on LP_USERNAME.
LP_NOTE_USERNAME=                  # e.g. agentic; blank = notes use LP_USERNAME
LP_NOTE_PASSWORD=                  # required whenever LP_NOTE_USERNAME is set
GHL_NOTE_CATEGORY_ID=1             # LP note category (nct_id) for standard notes
GHL_NOTE_IMPORTANT_CATEGORY_ID=    # LP note category (nct_id) for important notes; blank = use standard
GHL_NOTE_DEBOUNCE_MIN=30
GHL_NOTE_SWEEP_SEC=90
GHL_NOTE_RECON_MIN=30
GHL_NOTE_STALE_CLAIM_MIN=15
GHL_NOTE_MAX_ATTEMPTS=5
GHL_NOTE_TEXT_TYPES=2,3,5,11,18,29 # allowlisted channels (GHL numeric message types)
GHL_NOTE_DROP_TYPES=1,45           # calls + reactions
# Optional per-function model override for the summarizer (default claude-sonnet-4-6):
# GHL_NOTE_SUMMARIZER_MODEL_ANTHROPIC=claude-sonnet-4-6

# ─── Lead Gurus (I.LG — paid-media ingest, src/leadgurus-ingest.js) ──
# Paid-media agency platform (clients.leadgurus.com). Header X-API-Key.
LEAD_GURUS_API_KEY=
LEAD_GURUS_CLIENT_ID=91
# Contact enrichment is OFF until all 5 GHL custom-field IDs exist AND this is
# 'true'. Leave disabled until Mark creates the ft_* fields and captures IDs.
LEAD_GURUS_ENRICH_ENABLED=false
GHL_CF_FT_CAMPAIGN_ID=
GHL_CF_FT_CREDIT_SCORE=
GHL_CF_FT_PROJECT_TYPE=
GHL_CF_FT_SELF_BOOK_DT=
GHL_CF_FT_TERRITORY=

# ─── Anthropic API (for Response Generator) ──────────────────────
# Used by src/response-generator.js to generate Antifragile responses
ANTHROPIC_API_KEY=

# ─── OpenAI API (for KB embeddings) ──────────────────────────────
# Used by src/knowledge/openai-embeddings.js for text-embedding-3-small
# Required for vector search across the kb_embeddings table.
# Cost: ~$0.02 per 1M input tokens. Each response generation = ~1 embed.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── KB Vector Tier (Tier 2 semantic search — kb-retriever.js v1.9) ──
# KB_VECTOR_MODE gates whether the response generator searches kb_embeddings
# by meaning on QUESTION/OBJECTION (only when Tier 1 missed) and
# PRICING/SEND_INFO/UNCLEAR (always).
#   off    (default) never runs
#   shadow runs + logs to console and kb_vector_queries; NOT in the prompt
#   live   injected into the prompt as background context
KB_VECTOR_MODE=off
# Min cosine similarity to keep a chunk. text-embedding-3-small runs low;
# relevant hits land ~0.35–0.60. Calibrate from kb_vector_queries.
KB_VECTOR_MIN_SIMILARITY=0.35
# Max chunks returned per search.
KB_VECTOR_MATCH_COUNT=4
# Hard cap on embed + RPC time; past this the turn proceeds with no excerpts.
KB_VECTOR_TIMEOUT_MS=1500
# Total character budget for injected excerpts (live mode).
KB_VECTOR_MAX_CHARS=1500

# ─── Semantic Tier 1 (kb-retriever.js v1.10) ──────────────────────
# Makes the FAQ lookup and objection typing meaning-based.
#   off    (default) keyword path only — pre-v1.10 behaviour
#   shadow keyword answers; semantic runs and is logged to kb_vector_queries
#   live   semantic first, keyword fallback
# Flipping off→shadow also enables the boot/interval sweep that embeds kb_faqs.
KB_FAQ_SEMANTIC_MODE=off
# Cosine floor for an FAQ match (question+answer vs lead message). Calibrate
# from kb_vector_queries WHERE tier='kb_faqs'.
KB_FAQ_MIN_SIMILARITY=0.40
# Cosine floor for picking an objection type from the six type descriptions.
KB_OBJECTION_MIN_SIMILARITY=0.30
# How often to re-check kb_faqs for edited/added rows to embed. Default 6h.
KB_FAQ_EMBED_INTERVAL_MS=21600000

# ─── Past-win exemplars (kb-retriever.js v1.11) ────────────────────
# Retrieves real past exchanges (lead said → we replied) that led to a
# booking, as examples for the reply model.
#   off    (default) never runs; no corpus is built
#   shadow retrieves + logs to kb_vector_queries (tier='kb_exemplars'); not injected
#   live   injected as a PAST WINS block (approach/tone only, never wording)
# Flipping off→shadow also starts the sweep that builds kb_exemplars from HL.
KB_EXEMPLAR_MODE=off
# Cosine floor, lead message vs stored lead message.
KB_EXEMPLAR_MIN_SIMILARITY=0.45
# Max exemplars retrieved / injected per turn.
KB_EXEMPLAR_MATCH_COUNT=2
# Character budget for the PAST WINS block.
KB_EXEMPLAR_MAX_CHARS=1200
# A booking added within this many days of the inbound counts as a win.
KB_EXEMPLAR_OUTCOME_WINDOW_DAYS=14
# First sweep backfills this many days of HL messages.
KB_EXEMPLAR_BACKFILL_DAYS=120
# Sweep cadence (pair new messages, relabel pending, embed). Default 6h.
KB_EXEMPLAR_SWEEP_INTERVAL_MS=21600000

# ─── Call moments (kb-retriever.js v1.12) ─────────────────────────
# Mines homeowner objections / questions and the agent's answer out of CI
# transcripts, embeds the homeowner side, retrieves the closest resolved or
# booked moments as examples for the reply model.
#   off    (default) no extraction, no retrieval
#   shadow extraction runs; retrieval logged (tier='ci_moments'); not injected
#   live   injected as a FROM REAL CALLS block; objection classifier uses real
#          objections instead of the six descriptions once ≥3 neighbours exist
KB_CALL_MOMENTS_MODE=off
KB_CALL_MOMENTS_MIN_SIMILARITY=0.45
KB_CALL_MOMENTS_MATCH_COUNT=2
KB_CALL_MOMENTS_MAX_CHARS=1200
# Extraction sweep: calls per tick, tick interval (default 40 / 15 min).
KB_CI_MOMENTS_BATCH=40
KB_CI_MOMENTS_SWEEP_INTERVAL_MS=900000
# Transcripts shorter than this are skipped.
KB_CI_MOMENTS_MIN_TRANSCRIPT_CHARS=400
# Set false to keep the v1.10 six-description objection classifier even in live.
KB_OBJECTION_FROM_CALLS=true
# Model for the extraction call (fn key ci_moments, decision_engine group).
# Haiku is sufficient and ~5x cheaper than the group default.
CI_MOMENTS_MODEL_ANTHROPIC=claude-haiku-4-5-20251001

# ─── MCP Server ───────────────────────────────────────────────────
MCP_AUTH_TOKEN=
PORT=3000

# ─── Context Builder ─────────────────────────────────────────────
# In-memory context cache TTL (ms). Default 60000 (1 min). Was 5 min.
# Lower value reduces stale-data risk when other callers hit the cache.
CONTEXT_CACHE_TTL_MS=60000

# Threshold (minutes) above which lp_lead.synced_at is flagged stale
# for active dispositions. Lower = more LP refreshes, higher = more risk.
LP_DATA_STALE_THRESHOLD_MIN=15

# ─── Infrastructure Admin (v5.1) ─────────────────────────────────
# Railway API — project-scoped token from Railway dashboard
RAILWAY_API_TOKEN=
# Railway service ID for the LP MCP service
RAILWAY_SERVICE_ID=
# GitHub PAT — repo scope on LP MCP repository
GITHUB_PAT=
# GitHub repo path (org/repo format, e.g. 'reece-windows/lp-mcp-server')
GITHUB_REPO=

# ─── Webhook (optional) ───────────────────────────────────────────
N8N_WEBHOOK_SECRET=

# ─── Agentic cooling callbacks ───────────────────────────────────
# Token used by the GHL I.COOL-* workflows when POSTing cooling callbacks
# to /agentic/cooling/complete and /agentic/cooling/error.
# Set the SAME value in GHL custom_values.message_engine_token.
# Falls back to MESSAGE_ENGINE_TOKEN if unset.
AGENTIC_CALLBACK_TOKEN=

# ─── Agentic reply dispatcher (2026-07-03 rebuild, Steve Nkzhm incident) ──
# Master switch for direct agentic sends via the GHL Conversations API with
# channel + identity inherited from the triggering inbound (Live_Chat stays
# in the widget; SMS replies from the exact number the customer texted).
# 'false' = instant rollback to the legacy relay-workflow webhook path
# (requires GHL workflow 497e664a still published). Default: true.
AGENTIC_DIRECT_SEND=true

# NEPQ conversation layer (src/agentic/nepq-layer.js). Set to "off" to
# disable the questioning-discipline prompt block without a redeploy of
# logic. Any other value (or unset) leaves it ON.
NEPQ_LAYER_MODE=

# ─── LP callback re-queue (2026-08-18 — the push IS the dial trigger) ──
# No second re-queue LeadAdd for the same contact inside this window.
LP_REQUEUE_DEDUP_MINUTES=60

# ─── Callback re-queue destination (src/actions/handlers/lp-requeue.js,
#     src/five9/callback-push.js) ────────────────────────────────────────
# WHERE a callback re-queue sends its dial trigger.
#
#   five9      (default) — push a dialing copy into the Five9 "Callback
#                Request" list. LP stays the system of record and NO new LP
#                lead is created.
#   lp_leadadd — the pre-2026-09-04 path: an LP LeadAdd, which LP feeds into
#                LP_ASAP -> DIAL ASAP. Correct, and it MINTS A NEW LP LEAD
#                every time. On 2026-09-04 that duplicate (lead 573111) landed
#                in LP's Data queue and triggered LP's Revin bot to send
#                new-lead intake copy to a customer waiting at home for an
#                appointment we had already cancelled.
#
# This is the rollback switch for that change and is read per call, so
# flipping it in Railway takes effect without a deploy. An unrecognised value
# falls back to five9 rather than throwing — a typo must not take the callback
# path down entirely.
LP_REQUEUE_MODE=five9

# The Five9 list the callback push writes to. Mark built it in the admin UI;
# the name must match exactly. Unlike LP_ASAP this list is API-fed only, which
# is why writing to it directly is allowed at all — see the banner in
# src/five9/list-dispatch.js.
FIVE9_CALLBACK_LIST_NAME=Callback Request

# What makes a pushed record DIAL instead of waiting for the next list pass:
# listUpdateSettings.callNowMode on addRecordToList. One of
# NONE | NEW_CRM_ONLY | NEW_LIST_ONLY | ANY (verified against the live v13
# WSDL, 2026-09-04).
#
# ANY, per Mark. NOT NEW_LIST_ONLY: crmUpdateMode is UPDATE_FIRST, so a
# contact Five9's CRM already knows can be treated as an update rather than a
# new list record, and under NEW_LIST_ONLY that record would never be marked
# call-now — the promise silently unkept, which is the exact failure this path
# exists to prevent.
#
# Set to NONE to append without dialing (useful while the campaign is
# NOT_RUNNING). Anything outside the four values is refused by the builder.
FIVE9_CALLBACK_CALL_NOW_MODE=ANY

# LPRecType on the pushed record. LEAVE UNSET unless Mark has confirmed the
# value. Every row of the Data_Hot_Sample export reads "cst", but that export
# was a CUSTOMER list — evidence about customers, not callbacks. Other
# campaigns filter ON this value, so a wrong guess does not degrade the record,
# it leaks the record into another campaign's filter and gets the customer
# dialed by the wrong team. Unset = the field is omitted entirely, which cannot
# match any filter. The agent screen pop keys on CustID and does not need it.
FIVE9_CALLBACK_LPRECTYPE=
# GetLeadsByCQDID snapshot cache TTL for the queue precondition check
# (LP budget is 60 calls/min shared with the sync engine — never re-pull
# the Data queues per callback).
LP_REQUEUE_QUEUE_CACHE_TTL_MIN=10
# Max wall time for the Data-queue precondition sweep inside lp_callback_requeue.
# The executor kills a handler at 60s; a cold 5-queue sweep can exceed that on
# its own, and the resulting retries each posted a duplicate LP LeadAdd
# (2026-09-03, action 418351 → LP leads 572927/572928/572929). On timeout the
# handler proceeds without the precondition; the dedup guard is the safety net.
LP_REQUEUE_QUEUE_SCAN_TIMEOUT_MS=25000
# Bounded window for the verification sweep: a re-queue that has not
# produced a new lds_id by then fires a priority GroupMe (a promised call
# is never silently dropped). Sweep cadence + kill switch below.
LP_REQUEUE_VERIFY_WINDOW_MIN=12
LP_REQUEUE_VERIFY_INTERVAL_MS=120000
LP_REQUEUE_VERIFY_ENABLED=true
# LP employee name stamped on UpdateProspectInfo writes (LP requires it;
# LP doc default "lpservice").
LP_UPDATE_PROSPECT_EMPNAME=lpservice

# Outbound phone guard (2026-08-18 invented-phone incident): every agentic
# outbound body is scanned for US phone numbers; only numbers explicitly
# supplied to that send (resolved service phone, sending line, the contact's
# own number) may appear. enforce = refuse the send + GroupMe alert (default);
# shadow = alert but still send (rollback lever); off = disabled.
LP_PHONE_GUARD_MODE=enforce
# A livechat inbound older than this many minutes is treated as a closed
# widget session and downgraded to SMS (when the contact has a phone).
LIVECHAT_SESSION_TTL_MIN=15
# Minimum gap between agentic sends to one contact. A reply that becomes
# ready inside the gap is rescheduled and re-checks supersession first.
MIN_AGENTIC_SEND_GAP_SEC=90
# An in_flight agentic reply slot older than this is treated as a crashed
# holder and reclaimed at the next acquire.
LOCK_TTL_SEC=120

# ─── Booking offer window (v1.1 — 2026-07-24 Engelke incident) ───────
# Offered times start within the next N hours unless the lead named a specific
# farther day. The calendar FETCH stays wide (CAL_AVAIL_WINDOW_DAYS, default 14)
# so a lead-requested far date can still be matched; only the OFFER is narrowed.
BOOKING_OFFER_WINDOW_HOURS=48
# Minimum notice floor — a slot sooner than this is never offered (rep dispatch
# + drive time). CONFIRM real number with Mark/Edwin.
BOOKING_MIN_NOTICE_HOURS=4
# Escalation ladder (hours) when nothing is open in the standard window; each
# rung requires the "next two days are full" acknowledgment in the reply.
BOOKING_ESCALATION_LADDER=48,72,96,168
# GHL custom-field ids for persisting the lead's OWN stated time (fill-if-empty).
# "Preferred Estimate Time" already exists (defaulted in code). The two
# "Last Requested…" fields do NOT exist yet — Mark creates them and sets the ids
# here; until then those writes no-op.
# PREFERRED_ESTIMATE_TIME_FIELD_ID=7lpRWFDM8DZbLd3viHEG
# LAST_REQUESTED_DATE_FIELD_ID=
# LAST_REQUESTED_TIME_WINDOW_FIELD_ID=

# ─── LP Contact Auto-Create Backstop ─────────────────────────────
# Flag-gated 15-min sweep: finds-or-creates the GHL contact for unlinked LP
# leads with an upcoming Set/Cnf/Verif appointment (I.LP-IN webhook delivery
# misses ~30% of them), then reconciles the appointment. When not 'true' the
# scheduler no-ops; the admin endpoint POST /admin/lp-contact-backstop still
# works (dry-run default) for verification. Flip to true on Railway only after
# a reviewed dry-run.
ENABLE_LP_CONTACT_BACKSTOP=false
# Safety cap: max contacts created/linked per sweep run (excess carries to the
# next run — the scan self-heals as ghl_contact_id fills in).
LP_CONTACT_BACKSTOP_MAX_PER_RUN=50

# ─── Agentic Appointment Notifications (v1) ──────────────────────
# Feature flag for /api/agentic/notifications/appointment. When not
# 'true', the endpoint returns 503 and the GHL workflow's 30-min
# timeout fires the legacy fallback notification path.
ENABLE_ENHANCED_APPT_NOTIFICATIONS=false

# GHL custom field IDs for the team notification gate. Capture these
# from the GHL UI after creating the four custom fields:
#   Team Notification Body   — Multi-line text   (long-form email body)
#   Team Notification SMS    — Single-line text  (short-form SMS body)
#   Team Notification ID     — Single-line text
#   Team Notification Ready  — Single-option (Yes / No)
GHL_FIELD_TEAM_NOTIFICATION_BODY=
GHL_FIELD_TEAM_NOTIFICATION_SMS=
GHL_FIELD_TEAM_NOTIFICATION_ID=
GHL_FIELD_TEAM_NOTIFICATION_READY=

# Optional model override (defaults to claude-sonnet-4-5, falls back
# to NURTURE_GENERATOR_MODEL).
APPT_NOTIFICATION_MODEL=
APPT_NOTIFICATION_MAX_TOKENS=700
APPT_NOTIFICATION_TIMEOUT_MS=8000
APPT_NOTIFICATION_TEMPERATURE=0.4
APPT_NOTIFICATION_CONTEXT_TIMEOUT_MS=4000
APPT_NOTIFICATION_GHL_TIMEOUT_MS=10000
APPT_NOTIFICATION_EMAIL_CAP=1500
APPT_NOTIFICATION_SMS_CAP=300

# ─── Appointment / enrollment dedup (2026-07-25) ─────────────────
# Sliding window for appointment-event dedup in handleAppointment
# (src/services/appt-event-dedup.js). Dedup keys on the SLOT + last
# event type, not a status bucket, so a book→cancel→rebook still emits.
# Ignored when the webhook carries an appointment_id (permanently
# idempotent). The dedup lookup reuses EMIT_EVENT_TIMEOUT_MS as its
# per-call timeout and fails OPEN (emits) on any error.
APPT_DEDUP_WINDOW_MINUTES=60
# Window for the cross-rule enrollment guard in the action executor
# (src/services/enrollment-dedup.js): one contact must not be added to
# the same workflow twice within this many hours. Fails OPEN (enrolls).
WORKFLOW_REENROLL_WINDOW_HOURS=6

# ─── Appointment enrichment fetch (2026-07-28) ───────────────────
# fetchLatestAppointment in src/lp-appointment-sync.js called
# /calendars/events/appointments — a POST-only CREATION route — and so 404'd
# on every call since v5.1.6, leaving the calendar-name enrichment path
# dormant for months. Repointed to GET /contacts/{contactId}/appointments.
# Ships dark behind two flags; see the enable sequence below.
#
# Master gate. Anything other than 'true' → no fetch, returns null, which is
# byte-for-byte the pre-fix behaviour (calendar fields simply stay unset).
APPT_ENRICHMENT_ENABLED=false
# Shadow gate. NOTE the inverted default: anything other than the exact string
# 'false' (including UNSET) means log-only — the fetch runs and each outcome is
# recorded to system_events as appt.enrichment_fetch, but null is still
# returned, so nothing reaches the GroupMe card / GHL note / Five9 dispatch.
APPT_ENRICHMENT_LOG_ONLY=true
#
# Enable sequence — never skip a step:
#   1. Merge with both as shipped. Production behaviour unchanged.
#   2. APPT_ENRICHMENT_ENABLED=true, LOG_ONLY still true. Redeploy. The
#      repaired call now runs live but results never reach consumers.
#   3. Observe 24h: appt.enrichment_fetch should be predominantly 'ok', and
#      resolved names should match CALENDAR_NAME_MAP (short forms — "Window
#      Estimate", "MV", "HPA", "Confirmation Call", "Review Session").
#      Nulls, blanks, or unfamiliar names → STOP.
#   4. Only then APPT_ENRICHMENT_LOG_ONLY=false. This is the moment the
#      dormant path actually wakes up.
# WARNING: do NOT flip FIVE9_DIRECT_DISPATCH in the same change as step 4.
# A non-null calendarId lets isGhlOnlyCalendarId() divert Confirmation Call
# bookings past lpSetAppointment entirely (lp-appointment-sync.js).

# ─── IME MIC (Sam's Club Construction leads) ─────────────────────
# Reece is the affiliate provider for Sam's Club Construction leads.
# IME tokens expire in 30 minutes — refreshed automatically by src/ime/token-manager.js.
# All /ime/* routes use MCP_AUTH_TOKEN for auth.
IME_AFFILIATE_ID=17050371
IME_USERNAME=
IME_PASSWORD=
IME_BASE_URL_UAT=https://imewebapiexternal-uat.azurewebsites.net
IME_BASE_URL_PROD=
IME_ENV=uat                         # flip to "prod" after UAT validation
IME_TOKEN_REFRESH_BUFFER_MIN=5      # refresh 5 min before expiry
IME_RETRY_MAX=5                     # max retries per enrichment
IME_RETRY_INTERVAL_MIN=5            # retry-cron interval
IME_REQUEST_TIMEOUT_MS=15000        # per-call timeout

# ─── Map-Driven Entry Routing (routing fix, Step 2) ──────────────
# When 'true', lead entry-routing reads lp_source_mapping (granular
# source → correct entry tag + intent bucket) instead of letting the
# 6 coarse hygiene rules blanket-stamp entry:other. Gates BOTH the
# inferEntrySource Priority-0 safety net and the contact_created
# resolver. Default false = byte-for-byte current behavior.
ENTRY_RESOLVER_MAP_DRIVEN=false
# Optional: in-memory TTL (ms) for the cached lp_source_mapping table.
ENTRY_SOURCE_MAP_TTL_MS=300000

# ─── Revenue Scorecard (src/jobs/scorecard-metrics.js, goal-scorecard-daily.js) ──
# All optional — defaults below preserve current behavior. ⚠ TIE-OUT: calibrate the
# status sets against a real Reece "By Appt Date" export, then set
# SCORECARD_RECONCILED_MARKETS=REECE to flip the dashboard out of PROVISIONAL.
#
# Sold-deal job statuses RELEASED to production → counted as Net Sales.
SCORECARD_RELEASED_STATUSES=Rel To Production,RTP Await recission,RTP DP DUE,Awaiting Product
# Sold-deal job statuses HELD pre-release (financing/HOA/docs/measure) → Working Revenue.
SCORECARD_WORKING_STATUSES=HOLD - HOA,HOLD-Shutter Approval,Mgmt Hold,Awaiting Credit Application,Awaiting Lender,Awaiting Loan Docs,Awaiting Change Order,Awaiting Commission Sheet,Awaiting Paperwork,Out to Measure
# Sat dispositions EXCLUDED from the demo count (real LP labels: NOC=No Contact,
# NIS=Not Interested - Shown, 1Leg=One Leg Present — a sit, never a demo).
SCORECARD_NON_DEMO_DISPOSITIONS=NOC,NIS,1LEG
# Snapshot freshness watchdog (07:00 ET): GroupMe alert when the daily
# lp_market_scorecard_daily snapshot for the last completed selling day is
# missing. Alert-only; set true to silence.
SCORECARD_WATCHDOG_DISABLED=false
# (existing) Job statuses counted as KO / cancelled (drive the "Net" columns).
SCORECARD_CANCEL_STATUSES=Cancelled,Cancelled By Mgt,Dead Deal,Credit Decline
# (existing) Comma-separated markets confirmed reconciled → flips reconciled=true (default: none = provisional).
SCORECARD_RECONCILED_MARKETS=
# NIGHTLY live-month funnel attribution: 'true' attributes the daily scorecard
# branch-first (lp_lead_market_assignments, matching revenue); anything else (default)
# keeps the legacy prospect-ZIP attribution. OFF by default so a deploy is INERT until
# flipped — the closed-month re-derive (POST /n8n/admin/scorecard-market-rederive)
# always measures branch-first regardless of this flag, so the gate can be verified
# before the live-month behavior is switched on.
SCORECARD_BRANCH_FIRST_ATTRIBUTION=
# Selling-day calendar (src/selling-days.js) — drives days_elapsed (numerator) and
# working_days_in_period (denominator) on each snapshot. Must match the dashboard's
# SCORECARD_SELLING_DAYS / SCORECARD_HOLIDAYS so writer and reader share one basis.
SCORECARD_SELLING_DAYS=mon,tue,wed,thu,fri,sat
# Non-selling days: comma-separated YYYY-MM-DD, or "none". Default (empty) = the
# eight Reece closures — New Year's, Memorial Day, Independence Day, Labor Day,
# Thanksgiving, the day after, Christmas Eve, Christmas Day — with fixed dates
# shifted to the nearest weekday when they fall on a weekend. NOT the federal
# calendar: Juneteenth, Columbus and Veterans Day stay selling days.
# Leaving this empty is the norm; the built-in list is kept identical to the
# dashboard's lib/date/holidays.ts, so the two agree without any env coordination.
SCORECARD_HOLIDAYS=

# ─── Appointment Capacity Board (src/jobs/capacity-sweep.js, sql/043) ──────
# 15-min sweep: GetSalesSchedule denominator + forward-window lead disposition
# re-sweep + forward market assignments. Nightly 23:50 ET fill snapshot.
# All optional — defaults shown.
CAPACITY_SWEEP_INTERVAL_MS=900000
CAPACITY_FORWARD_DAYS=14
# Dispositions that count as CONFIRMED (Mark: Confirmed = Cnf + Verif; Set
# does NOT count — unconfirmed appointments don't run). The explicit GetLead
# confirmed boolean (lp_leads.appointment_confirmed) is preferred when present;
# these codes are the fallback for rows synced before that column existed.
CAPACITY_CONFIRMED_CODES=Cnf,Issue
# Dispositions excluded from confirmed AND set_pending (still counted in appts).
CAPACITY_EXCLUDED_CODES=CXL,DNC
# Near-window full refresh: appointments today..today+N days ET are re-fetched
# PER LEAD every sweep (exact counts for the dates the board is for, immune to
# LP change-window semantics). ~100-200 GetLead calls per sweep at N=2.
CAPACITY_NEAR_DAYS=2
# At-risk bucket (set-but-not-confirmed; rendered as the red "at risk" count).
CAPACITY_AT_RISK_CODES=Set,Verif
# Pause between continuous lead-pass cycles (near-window refresh + change
# window). The fast pass (slots + assignments) runs on CAPACITY_SWEEP_INTERVAL_MS.
CAPACITY_LEAD_LOOP_PAUSE_MS=60000
# Change-window page size. GetLead rows are huge full prospect records; LP's
# server 500s assembling heavy pages at deep offsets (observed truncation at
# row ~199 with PageSize 200). Keep small so every page is servable.
CAPACITY_LEAD_PAGE_SIZE=50
CAPACITY_LEAD_MAX_PAGES=80
# Change-window lookback days (before today ET). 3 self-heals recent sync
# drops; raise temporarily (e.g. 14) to recover older ones.
CAPACITY_CHANGE_BACK_DAYS=3
# Corner dial-priority badge on the Appointment Capacity board. How long to cache
# the LIVE Five9 list order on "Data - Hot Leads less than 7" (default 5 min), and
# how long to back off after a failed read (default 60s). Optional — defaults are
# correct; no Railway change is required to ship this.
CAPACITY_DIAL_RANK_TTL_MS=300000
CAPACITY_DIAL_RANK_ERROR_TTL_MS=60000

# ─── Band-level capacity diagnostic (src/jobs/capacity-bands.js, sql/048) ──
# Read-only: GET /admin/capacity-bands + the get_capacity_vs_ghl MCP tool.
# Reconciles GHL bookings against LP per-band rep availability (slot_id
# 1=Morning, 2=Afternoon, 3=Evening). All optional — defaults shown.
#
# Band cut points: the LAST minute of Morning and of Afternoon, ET, 24h.
# These are LP's own TmsTime markers. Verified against live GHL bookings:
# 10:00 → M, 14:00 → A, 18:00/18:30/19:00 → E (one LP evening slot per rep).
# A single source of truth — both the JS mapping and the SQL CASE derive from
# it, so a band shift is an env flip. Malformed values warn and fall back.
# Per-market cuts are NOT supported; if evening starts earlier in some markets
# this has to become per-market rather than global.
CAPACITY_BAND_CUTS=12:59,16:59
# GHL statuses that OCCUPY a slot. 'cancelled' is reported separately and never
# counted as booked. Anything outside this list stays visible via ghl_total.
CAPACITY_BAND_GHL_STATUSES=new,confirmed,showed,noshow
# Fraction of band capacity at which a row is reported TIGHT (below OVERSOLD).
CAPACITY_BAND_TIGHT_RATIO=0.8
# Default forward window when end_date is omitted.
CAPACITY_BAND_FORWARD_DAYS=14
# Hard cap on the requested window. The GHL-side ET date predicate is
# non-sargable, so an unbounded window scans a table shared with HL MCP.
CAPACITY_BAND_MAX_WINDOW_DAYS=60
# Default GHL calendar (Window Estimate).
CAPACITY_BAND_CALENDAR_ID=aJj14ONxh1oFyDcQ706O
# NOTE: GHL booking counts come from the HL MCP Supabase, so this diagnostic
# also needs HL_SUPABASE_URL + HL_SUPABASE_SERVICE_ROLE_KEY (see the HL
# fallback section). Without them the route still returns LP-side capacity with
# degraded:true rather than failing.

# Mirror-backfill page size — LP returns empty/500 for big pages at deep
# offsets; keep small so every page is servable.
LP_MIRROR_PAGE_SIZE=50

# ─── Incremental sync paging (src/sync-engine.js) ──────────────────────────
# GetLead rows are huge full prospect records; LP errors or returns EMPTY for
# big pages at deep offsets (indistinguishable from scan completion). Keep
# pages small so every page is servable; failed pages retry smaller and log
# TRUNCATED loudly instead of ending the sweep silently.
SYNC_PAGE_SIZE=50

# ─── GHL slot uniqueness + delegated booking (src/appointments/) ───────────
# Two systems create GHL appointments and neither asked GHL whether the slot
# was already taken: LP MCP via the API (createdBy.source = third_party) and
# the GHL workflow I.LP-IN via native booking nodes (source = workflow, and
# every one of those nodes sets ignoreFreeSlots:true). Measured over 60 days on
# the three estimate calendars, 619 of 5,182 slots held more than one
# appointment and 400 of those were MIXED — one from each writer — so fixing a
# single writer leaves ~two thirds of the problem in place.
#
# Master switch. SHIPS DARK: every call site falls through to its previous
# behaviour unless this is exactly 'true'. Rollback is setting it back to false
# and redeploying; the endpoint stays live and harmless (it 503s while off).
APPT_SLOT_CHECK_ENABLED=false
# Start times within this many seconds of each other are treated as the same
# slot. Compared on absolute instants (epoch ms), never wall-clock strings —
# GHL returns ISO with an offset.
APPT_SLOT_MATCH_WINDOW_S=60
# Shared key for POST /webhook/ghl/create-appointment-from-lp, sent as the
# x-appt-booking-key header. Constant-time compare, FAIL CLOSED: while this is
# unset the endpoint accepts nothing. Generate a random value per environment.
APPT_BOOKING_ENDPOINT_KEY=

# ─── Contact-scoped appointment authority (2026-08-03) ─────────────────────
# Exactly ONE LP lead may drive a GHL contact's appointment at a time
# (src/services/contact-appointment-authority.js). Appointment authority used
# to be scoped per LEAD, so any of a contact's sibling leads could drive its
# single appointment object: on 2026-08-02 three leads on prospect 449759 did,
# inside 100 minutes, and the customer was texted a time nobody agreed to.
#
# Master switch. SHIPS DARK: every call site falls through to its previous
# behaviour unless this is exactly 'true'. While off, claims are still recorded
# and appointment.authority_denied is still emitted, so the denial set can be
# sized before anything is blocked:
#   SELECT payload->>'reason', payload->>'enforced', count(*)
#   FROM system_events WHERE event_type='appointment.authority_denied' GROUP BY 1,2;
# Do not flip this until the authority_unavailable rate is zero — that reason
# means the claim is failing on infra, not on arbitration.
# Rollback is setting it back to false and redeploying.
APPT_AUTHORITY_ENFORCE=false
# Ownership starvation release. If the owning lead's LP row (updated_at_lp)
# has not been touched in this many days, a live sibling may take the seat —
# otherwise a wedged owner would hold a contact forever, since an authority row
# existing at all closes the first-writer path.
APPT_AUTHORITY_STALE_DAYS=14

# ─── Action executor watchdog (src/actions/index.js) ───────────────────────
# Per-handler watchdog ceiling for set_lp_appointment ONLY. That handler runs
# the five-step LP lead-resolution chain, then LP SetAppointment, and on a miss
# a GHL workflow enrollment — each leg with its own rate-limiter wait, so the
# 60s global ceiling (EXECUTOR_HANDLER_TIMEOUT_MS) sits below its honest worst
# case and fires on healthy-but-queued calls. Never resolves BELOW the global
# ceiling. The 10-min stuck-action reaper is still the real backstop.
EXECUTOR_LP_APPOINTMENT_TIMEOUT_MS=120000

# ─── LP scheduled-report PDF ingestion (src/jobs/lp-report-*.js) ────────────
# Optional shared secret for POST /n8n/admin/lp-report-ingest/*. When set, the
# request must carry it in x-ghl-signature (n8n sends $env.LP_WEBHOOK_SIGNATURE
# — set this to the same value). Unset = open route (house default).
LP_REPORT_INGEST_SECRET=
# Kill switch for the 07:30 ET missing-report watchdog (set to any value).
LP_REPORT_WATCHDOG_DISABLED=
# Daily 07:00 ET cross-source reconciliation. Default on; set to 'false' to skip.
LP_REPORT_RECON_ENABLED=true

# ─── Five9 gated admin writes (src/five9/admin-writes.js) ──────────────────
# Master flag. Unset or anything other than 'true' = DRY-RUN: every guardrail,
# read-before-write and SOAP body build still runs, the envelope is logged, but
# no mutation is sent. Arming this is a deliberate, separate decision.
FIVE9_WRITES_ENABLED=
# Ceiling on campaign-profile numberOfAttempts for gated Five9 writes.
# Same posture as the 3% abandon line: exceeding it requires an explicit
# compliance_override:true on the action payload. Live `Data Leads` profile
# was found at 100 attempts on 2026-08-05.
FIVE9_MAX_PROFILE_ATTEMPTS=12
# Floor on CRMRedialTimeout for gated Five9 outbound campaign patches, in
# SECONDS. Going below it requires compliance_override:true on the payload.
# DIAL ASAP and After DIAL ASAP both sat at 2 hours (7200s), which is what put
# an hour-plus gap between a new lead's first and second call.
FIVE9_MIN_CRM_REDIAL_SEC=300
# Per-action ceiling on BULK list deletion
# (five9_async_delete_records_from_list). Above this, the action refuses
# unless the payload carries compliance_override:true, which is recorded on
# the five9.admin_write audit event. A second, independent line also refuses
# any request that would remove more than 50% of the list — that one catches
# a bad cohort query nuking the list instead of the intended subset, which
# the absolute ceiling cannot detect on its own.
FIVE9_MAX_LIST_DELETE=2000
# Fleet-wide serialization lock TTL for Five9 admin writes, in SECONDS. One
# write in flight at a time (outbound_locks key "five9_admin:write").
FIVE9_WRITE_LOCK_TTL_SEC=120

# ─── Five9 dial window (src/dial-window.js) ───────────────────────────────
# The hours Five9 will actually place an outbound call, in EASTERN, used to
# tell the reply model whether an immediate callback can be promised.
#
# These are NOT office hours and NOT SMS quiet hours. They mirror the Five9
# dialing schedule and nothing else. Verified live 2026-09-04: all 14 campaign
# profiles, "Callback Request" included, dial 08:00-21:00 every day. The
# defaults below are those values, so leaving these unset is already correct.
#
# Read per call, not at module load, so a change to the Five9 dialing schedule
# can be followed from Railway without a redeploy. Whole hours 0-24 only; a
# malformed value falls back to the default rather than being clamped, because
# a clamped 0 would tell the bot the phone room is open at midnight.
#
# End hour is EXCLUSIVE: with 21, 20:59 ET is open and 21:00 ET is closed,
# matching the Five9 stopTime.
FIVE9_DIAL_WINDOW_START_HOUR_ET=8
FIVE9_DIAL_WINDOW_END_HOUR_ET=21
# Guardrail 13 — destination allow-list for Five9 WEB CONNECTORS
# (five9_create_web_connector / five9_modify_web_connector). Comma-separated
# HOSTNAMES, matched EXACTLY: an entry of "example.com" does NOT permit
# "evil-example.com" or "a.example.com". A destination must additionally be
# https (never http, at any host), carry no embedded credentials, use no
# non-standard port, and not be an IP literal. The same check is applied to
# every value in the connector's constants / postConstants / variables /
# postVariables / startPageText, because a second destination hidden in a POST
# constant defeats a check that only reads `url`.
#
# UNSET OR EMPTY MEANS THE ALLOW-LIST IS EMPTY, WHICH REFUSES EVERY
# DESTINATION AND SO DISABLES BOTH OPERATIONS. It never means "allow all" —
# the guardrail fails closed by design. There is deliberately NO
# compliance_override path: an override would reintroduce the arbitrary-URL
# hole these ops were originally denied for, one approved action at a time.
# Adding a destination is a deliberate edit here, which is also the only
# record of the decision.
FIVE9_WEBCONNECTOR_ALLOWED_HOSTS=lp-mcp-production.up.railway.app

# ─── Capacity → Five9 list priority ranker (src/routes/capacityRanker.js) ────
# POST /n8n/capacity-ranker/run reads next-day appointment capacity from the
# same aggregate the Appointment Capacity TV board polls (GET /board/capacity),
# ranks the seven markets by ABSOLUTE OPEN SLOTS scaled by a bounded market
# performance weight, with fail-open / oversold guards, and logs the ranking to
# dial_priority_log.
#
# shadow (default) — compute, log and return the ranking. NEVER writes to Five9.
# live             — additionally reorders the two Data campaigns' list
#                    dialingPriority on a material change. FIVE9_WRITES_ENABLED
#                    above must ALSO be 'true' for anything to reach Five9; with
#                    it off the write dry-runs and applied stays false.
# Anything other than the literal 'live' is shadow. Not flipped in the PR
# that introduced it — Mark reviews at least five working days of shadow
# output against the dashboard first.
CAPACITY_RANKER_MODE=shadow
# Minimum SCORE GAP, IN SLOTS, two markets must differ by for a rank swap
# between them to count as a material change (state changes — oversold /
# small_denominator / starvation_promoted / unknown — are always material).
# Default 0.5. This used to be 5 fill-percentage POINTS; a fill margin is
# meaningless now the sort key is a slot count, and the 0.5-slot floor is what
# stops a fractional performance-weight difference alone from re-pointing the
# floor. A market genuinely gaining or losing a slot still counts.
CAPACITY_RANKER_SWAP_MARGIN=0.5
#
# ── Market performance weight (power ranking) ──────────────────────────────
# score = open_true × clamp(1 + W × (market_set_to_sale / company - 1), 0.85, 1.15)
# where set_to_sale = SUM(sales) / SUM(sets) over a trailing window from
# lp_market_scorecard_daily, deduped by (market, period_start) taking the
# latest as_of_date — that table stores month-to-date CUMULATIVE snapshots and
# summing its raw rows multiplies the totals ~13x. Memoised 12 hours;
# performance does not move hourly and recomputing invites flapping.
#
# W. Default 0.25, giving a real spread of 0.91–1.05 on current data — enough
# to break a near-tie (Fort Myers over St. Pete when both have 7 open), never
# enough to flip a 7-vs-4 gap. 0 disables weighting entirely (pure open-slot
# order). Tunable without a deploy; the ±0.15 clamp holds at ANY value, so
# capacity always dominates performance.
RANKER_PERF_WEIGHT=0.25
# Trailing window in days. Snapped back to the FIRST OF ITS MONTH before it is
# used, because the scorecard table's grain is monthly — a bare 90-day cutoff
# lands mid-month and silently drops that whole month (which read the company
# baseline as 12.5 % instead of the true 13.5 %).
RANKER_PERF_WINDOW_DAYS=90
# Minimum sets in the window before a market is weighted at all. Below this the
# multiplier is EXACTLY 1.0 — a small market is never penalised for being
# small, only for converting badly on real volume.
RANKER_PERF_MIN_SETS=100
# Stop → reorder → restart the two Data campaigns so the list write can land
# while they are RUNNING (modifyCampaignLists refuses a RUNNING campaign).
# Only acts when 'true' AND CAPACITY_RANKER_MODE=live AND the clock is inside
# 07:00–20:30 ET. One campaign at a time, graceful stop only (never force),
# restart in a finally block, verified; a campaign that does not come back
# forces applied=false, a 500, a durable alert, and disables cycling for the
# rest of the day (cycle_disabled_until in dial_priority_log — clear it to
# re-arm). Ships false. Do NOT enable until the n8n watchdog (OPS - Capacity
# Ranker Campaign Watchdog) is active — it covers a process crash between stop
# and start, which the finally cannot, and it now calls
# POST /n8n/capacity-ranker/heal to restart whatever was left dark.
CAPACITY_RANKER_CYCLE_CAMPAIGNS=false
#
# ── Restart hardening (the 2026-09-04 two-hour dark campaign) ──────────────
# "Data - Warm Leads less than 30" sat NOT_RUNNING for roughly two hours after
# a reorder stopped it and the restart never succeeded (dial_priority_log id
# 24, downtime_ms 199717, ~2,600 warm leads undialed). The old budget was 3
# attempts at a flat 2s — about six seconds — and then it gave up permanently.
# A run that gives up on a restart is worse than a run that never cycled.
#
# Attempts per campaign restart. Exponential backoff capped at 60s
# (2, 4, 8, 16, 32, 60, 60, …), each attempt verified by polling state for up
# to 15s before it counts as failed — a start that is still transitioning is
# not a failed start.
RANKER_RESTART_MAX_ATTEMPTS=10
# Wall ceiling across all of those attempts, in ms. Whichever runs out first —
# attempts or ceiling — ends the restart.
RANKER_RESTART_CEILING_MS=600000
# How long to wait for a graceful stop to actually settle to NOT_RUNNING before
# writing the campaign's lists, in ms. Polled every 2s. Five9 reports STOPPING
# while it drains calls in progress and refuses BOTH the list write and a start
# for that whole window; the observed drain was ~25s. On a timeout the reorder
# is skipped and the campaign is restarted — the run aborts cleanly rather than
# lengthening the dark window for a write that cannot land. The observed settle
# time is recorded per run in dial_priority_log.settle_ms.
RANKER_STOP_SETTLE_TIMEOUT_MS=30000
# How many times POST /n8n/capacity-ranker/heal may restart ONE campaign in ONE
# ET day before it stands down and pages instead of restarting again. Default 2.
#
# WHY. 2026-09-04: Warm went NOT_RUNNING at ~22:05 and again at ~22:15 with
# cycling OFF — so no failed cycle could have caused either, and heal restarted
# it both times. Each round cost three GroupMe cards (outage, healed,
# recovered). Heal cannot tell "dark because our cycle failed" from "Five9
# stopped it for its own reasons" (an exhausted dialable set looks identical
# from outside), so past a couple of repeats the right move is to stop
# restarting and tell a human.
#
# Past the cap heal still SEES the campaign and still opens an alert condition
# for it — it just stops restarting. The counter lives in
# dial_priority_log.heal_attempted, resets at ET midnight, and is durable so a
# Railway restart cannot hand a flapping campaign a fresh budget.
#
# Heal also observes-only whenever CAPACITY_RANKER_CYCLE_CAMPAIGNS is false,
# for the same reason: the ranker never stopped the campaign, so the outage is
# not one heal caused. POST {"force":true} overrides that for a manual repair.
RANKER_HEAL_MAX_PER_DAY=2
# TTL for the fleet-wide run lock, in ms. Default 900000 (15 minutes) — longer
# than the worst observed run now that a restart may spend up to ten minutes
# coming back. CAPACITY_RANKER_LOCK_TTL_SEC below still wins if it is set.
RANKER_LOCK_TTL_MS=900000
# TTL in seconds for the fleet-wide run lock that keeps two ranker runs from
# overlapping (outbound_locks key capacity_ranker:run). A run is a SEQUENCE of
# Five9 writes and the per-write lock releases between each one, so without
# this two runs can interleave — run A stops Hot, run B stops Warm, and the
# floor goes dark. Held in Supabase rather than process memory so it survives a
# Railway restart, which is exactly when it matters. Default 600: long enough
# for the slowest legitimate run (two campaigns each waiting out a STOPPING
# drain), and a crashed run leaks it for at most that long, which costs nothing
# because the cron is hourly. Legacy knob: RANKER_LOCK_TTL_MS above wins when
# both are set. Leave unset.
CAPACITY_RANKER_LOCK_TTL_SEC=
# The watchdog behind that flag lives on GET /n8n/capacity-ranker/campaign-state.
# It sends its GroupMe alert from HERE using GROUPME_BOT_ID above, because that
# variable is not set on either n8n service. n8n only polls the route. No new
# variable: the on switch is the n8n workflow's active state, since nothing
# else calls the route.

# ─── Five9 config snapshot + change log (src/jobs/five9-config-snapshot.js) ──
# Daily point-in-time record of every Five9 configuration object, plus a
# field-level change log. Read-only — never repairs drift it finds. Ships dark.
FIVE9_CONFIG_SNAPSHOT_ENABLED=false
# ET hour for the daily run (0-23).
FIVE9_CONFIG_SNAPSHOT_HOUR_ET=4
# Delay between sequential Five9 SOAP reads during a snapshot run, in ms.
# ~30 campaigns means ~30 sequential getOutboundCampaign calls; Five9's
# concurrent admin session limits are undisclosed and we do not probe them.
FIVE9_SNAPSHOT_DELAY_MS=250

# ─── Appointment Parity Watchdog (src/jobs/appointment-parity-watchdog.js) ──
# Bidirectional LP<->GHL appointment reconciliation.
PARITY_AUTOHEAL=false          # writes OFF by default; true enables auto-heal
PARITY_WINDOW_DAYS=45          # how far ahead to reconcile
PARITY_MAX_WRITES=25           # per-run write ceiling
PARITY_INTERVAL_MS=1800000     # 30 minutes

# v6.11 hash gate + soft-fail backoff (sync-engine.js)
# SYNC_HASH_GATE_MODE: off | shadow | enforce (CODE default shadow).
# shadow computes and persists hashes and logs would-skip counts but still
# processes everything; enforce actually skips the unchanged prospects.
#
# PRODUCTION IS SET TO `enforce` ON RAILWAY (verified 2026-09-04 from the
# running process, which reports its own mode: "[Sync:Leads] Hash gate
# (enforce): 395 unchanged prospects skipped").
#
# RAILWAY IS AUTHORITATIVE FOR EVERY VALUE IN THIS FILE. This file is
# documentation of what a variable means, never a record of what it is set to —
# it cannot see the Railway environment, and a Railway value silently overrides
# whatever is written here. Read the variable, not this file, before making any
# claim about a runtime mode. This line stating `shadow` while production ran
# `enforce` is what nearly hid a live attribution-freeze bug (#839).
SYNC_HASH_GATE_MODE=enforce
# Ceiling on prospects FETCHED per sweep (changed or not). Changed-lead cap is
# still MAX_INCREMENTAL_LEADS.
MAX_SCANNED_LEADS=5000
# Exponential backoff when LP soft-fails (empty page where rows exist / page error).
SYNC_SOFTFAIL_BACKOFF_BASE_MS=2000
SYNC_SOFTFAIL_BACKOFF_MAX_MS=30000

# v6.13 sync window cursor (sync-engine.js)
# SYNC_WINDOW_MODE: date | timestamp (DEFAULT timestamp as of 085/WO-11).
# `date` is the legacy midnight-truncated window that re-scans everything
# changed today, every run — a fixed start with a moving end. It was the
# default, production was running it, and it IS the 2026-09-04 degradation:
# runs went 0.16min at 05:00Z to 16.93min by 18:00Z, resetting every midnight
# ET. `timestamp` sends a real cursor; LP's tolerance for a time component is
# probed with one 1-row call per run and falls back to `date` if rejected.
# RAILWAY IS AUTHORITATIVE — a value set there overrides this default, so an
# explicit SYNC_WINDOW_MODE=date on the service keeps the old behaviour.
SYNC_WINDOW_MODE=timestamp
# Overlap subtracted from the cursor — defence in depth since 085.
# It used to be the ONLY defence: the cursor was completed_at while a sweep
# reads across [started_at..completed_at], so a lead changed mid-sweep was
# skipped permanently unless the overlap out-ran the sweep. 085 anchors the
# cursor at started_at instead, which removes the hazard at the source, so this
# no longer has to exceed the longest sweep.
# Lowered 90 -> 30 in production on 2026-09-04: at 90 it was the binding
# constraint on window width (~1.75h floor) once the date truncation was gone.
# RAILWAY IS AUTHORITATIVE for this value.
SYNC_WINDOW_OVERLAP_MIN=30
# Wire format for the timestamped startdate: space -> "YYYY-MM-DD HH:mm:ss",
# iso -> "YYYY-MM-DDTHH:mm:ss".
SYNC_WINDOW_TS_FORMAT=space
# 085 (WO-12) watermark kill switch. Default true: the incremental cursor
# advances on any run that DRAINED its window, whether or not it wrote rows.
# Set false to revert to the pre-085 rule (advance only on runs with
# records_synced > 0, anchored at completed_at) — which, now that #837/#846
# skip unchanged writes, discards every quiet run and lets the window creep
# open again. RAILWAY IS AUTHORITATIVE for this value.
SYNC_WATERMARK_FROM_PROCESSED=true

# v7.5 skip unchanged job + milestone writes (src/sync-children.js)
# KILL SWITCH ONLY — the default (unset) is ON. Do not set this to deploy.
#
# Calls, notes and activities have skipped already-present rows since v7.0.
# Jobs and milestones did not: every job payload rewrote its lp_jobs row
# (raw_lp_data JSONB included) and every milestone in it, whether or not one
# field had changed. Both rows stamp synced_at, so each of those was a real
# write. Measured 2026-09-04: 2,111 milestone rows written per incremental pass
# against 2 leads that had actually changed, on a 7m 31s sync.
#
# Set to the string `false` on Railway to restore the old always-write
# behaviour without a deploy — the recovery step if a real LP change is ever
# observed NOT propagating to Supabase.
#
# NOT SET ON RAILWAY as of 2026-09-04, so production runs the default (ON).
# As above: Railway is authoritative. Confirm against the Railway variable
# before asserting this is on or off.
# SYNC_SKIP_UNCHANGED_CHILDREN=false

# ─── Call Intelligence pipeline (src/ci/config.js) ──────────────────────────
# Five9 recordings → transcription → structured AI analysis → deterministic
# lead match → CRM notes (LP AddNotes + GHL contact note), full audit in the
# ci_* tables (sql/061). Ships dark: in shadow mode the full pipeline runs and
# notes are composed and stored in Supabase, but ZERO CRM writes happen.
# Master switch: shadow | live. Anything that is not exactly 'live' (unset,
# typo, anything) coerces to shadow — a misconfigured deploy fails toward no
# writes. Flipping to live is Mark's decision, never part of a PR.
CALL_INTEL_MODE=shadow
# Per-target write flags, each ANDed with mode=live. Both must stay false
# until the shadow acceptance gates pass (handoff §15); LP flips first, GHL a
# week later.
CALL_INTEL_LP_WRITES=false
CALL_INTEL_GHL_WRITES=false
# GHL contact CREATION (not just notes) — duplicate-contact risk is the top
# danger. Stays false until LP+GHL matching has ≥2 weeks of shadow QA.
CALL_INTEL_GHL_CREATE=false
# LP writes at match tier 'probable' (the default write threshold is
# exact|high only).
CALL_INTEL_ALLOW_PROBABLE=false
# Eligibility duration floor (seconds) — calls shorter than this are recorded
# as skipped with a reason, never processed.
CALL_INTEL_MIN_SECONDS=30
# Worker claim batch size and per-stage attempt ceiling. Backoff between
# attempts is next_retry_at = now + min(6h, 5min × 2^attempts).
CALL_INTEL_BATCH_SIZE=10
CALL_INTEL_MAX_ATTEMPTS=5
# Hours to keep retrying when a discovered call has no recording yet before
# parking it in review (recording_missing — a human may locate it).
CI_RECORDING_WAIT_HOURS=6
# Days audio stays in the private 'ci-audio' bucket after transcription, then
# purged (row kept, purged_at set). Five9 remains the recording system of
# record; transcripts and structured outputs are retained indefinitely.
# ALSO sets how long a note's Recording: link works — link_expires_at is
# fetched_at + this, so the link dies exactly when the audio does.
CI_AUDIO_RETENTION_DAYS=7
#
# Origin for the recording link in a CRM note, e.g.
#   CI_RECORDING_LINK_BASE=https://lp-mcp-production.up.railway.app
# NO DEFAULT, deliberately. Unset means notes simply omit the Recording: line
# and everything else behaves exactly as before — a guessed default would paste
# a URL nobody can open into two CRMs. Set this only to an origin that actually
# serves this app.
#
# ⚠ What this switches on is a PUBLIC route: GET /ci/rec/:token sits outside
# the auth guards by design (Mark, 2026-08-24 — a rep must be able to forward a
# note and have the link still work). Access control is the token alone: 32
# random bytes, base64url, derived from nothing. The ci-audio bucket itself
# stays PRIVATE — the route mints a 300s signed URL and redirects. Never make
# the bucket public and never add a public policy to it.
CI_RECORDING_LINK_BASE=
# OpenAI transcription. Key is a secret — Railway env only. Transcription goes
# straight to OpenAI's audio API (the house llm-client is chat-only).
OPENAI_API_KEY=
CI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
#
# ── THE EARLY MATCH GATE ──────────────────────────────────────────────────────
# Transcribe a call the matcher resolved to tier 'none' — i.e. no writable
# target and therefore no note to write?
#
# Matching runs BEFORE transcription (discovered → fetched → matched →
# transcribed → analyzed → syncing) because it keys on campaign + customer
# phone against LP and reads nothing from the transcript. Measured over 4,154
# transcripts / 113.5 audio-hours (~$40.86 at whisper-1's $0.006/min): 2,120
# calls — 51% of the spend — produced no writable match and so no note.
#
# ⚠ OPT-OUT, NOT OPT-IN. Unset means TRUE means "transcribe them anyway", which
# is exactly today's behaviour; only the literal string 'false' arms the gate.
# It ships that way on purpose: some tier-'none' callers are genuinely NEW
# leads, and for those the transcript is the only record of who rang and what
# they wanted. With the default, the gate still logs what it WOULD have saved
# (ci_events stage='match_gate') and GET /ci/health reports it under
# `match_gate` — read that before turning this off.
#
# Three cases bypass the gate whatever this is set to: canvasser_ani calls (the
# canvasser routing design NEEDS those transcripts), tiers 'ambiguous' and
# 'probable', and any call that already has a transcript.
#
# Also note what turning it off gives up: match.js's name+address fallback runs
# only when the phone found nothing and needs the AI's customer name/address,
# which does not exist yet at gate time.
CI_TRANSCRIBE_UNMATCHED=true
#
# ⚠ DO NOT SET CI_ANALYSIS_MODEL.
# Analysis goes through src/llm-client.js under fn key 'ci_analysis'. For that
# key, CI_ANALYSIS_MODEL is the client's legacy single-model var and is read as
# the ANTHROPIC model — so an OpenAI id there gets sent to Anthropic and the
# call 400s. Analysis inherits the decision_engine group by default. To run it
# on OpenAI instead, set BOTH of these and leave CI_ANALYSIS_MODEL unset:
#   CI_ANALYSIS_PROVIDER=openai
#   CI_ANALYSIS_MODEL_OPENAI=<an OpenAI model id>
#
# Version stamp stored on every ci_summaries row so outputs are reproducible.
CI_PROMPT_VERSION=v1
# Which channel of a 2-channel recording carries the AGENT (0 or 1).
# ⚠ UNVERIFIED against a real Five9 stereo file. Wrong, it swaps 'agent' and
# 'customer' on every labelled line of every transcript without erroring.
# Confirm against one real two-channel recording before flipping to live.
CI_STEREO_AGENT_CHANNEL=0
# ─── recording→call join (sql/062) ──────────────────────────────────────────
# The Five9 Call ID is NOT in the recording filename (verified 2026-08-20 —
# the leading number is the ANI). Recordings join to calls on campaign + ANI +
# timestamp instead. This is the tolerance on that timestamp comparison;
# repeat dials to one number minutes apart are common, so a too-wide window
# links the wrong call and a too-narrow one leaves recordings unlinked.
CI_RECORDING_MATCH_WINDOW_S=180
# Skip files below this size. The transfer-module test calls from 8/14 and
# 8/17/2026 are ~1 second and 1.7–4.9 KB; they are marked excluded
# (below_min_bytes), never ingested.
CI_MIN_RECORDING_BYTES=8000
# THREE timezones meet in the join above and getting this wrong misses every
# match by an hour for eight months a year:
#   Call Log report  -> Pacific, lags 5–10 min
#   Recording files  -> FIXED EST (GMT-05:00), NO DST  <- this variable
#   Display          -> ET (America/New_York, DST-aware)
# So this is -300 year-round. Never substitute America/New_York, which would
# apply DST. Verified: '9419203087 by  @ 4_30_12 PM' was written 21:31 UTC.
CI_RECORDING_TZ_OFFSET_MIN=-300
# Date recording was enabled on the canvass transfer module. Transfer legs
# before this legitimately have no audio, so reconciliation must not flag them
# as gaps. Blank until set (PHASE 0 2b).
CI_TRANSFER_RECORDING_ENABLED_FROM=
# ─── SFTP recording pull — ETG's archive (RESOLVED 2026-08-20) ──────────────
# Read-only pull from the vendor archive Five9 already pushes to. Layout is
# /Five9/Recordings/{CAMPAIGN NAME}/{M_D_YYYY}/{file}.wav — campaign dirs are
# matched EXACTLY, never case-folded (near-duplicates exist, e.g.
# 'Magazine - CLiPP' vs 'Magazine - Clipp'), and date dirs are NOT zero-padded.
CI_SFTP_HOST=nas1.etgts.com
# 2282 — CONFIRMED LIVE 2026-08-23: connected, listed, and downloaded a real
# recording in ~3s. Port 2022 was tried first and does NOT work: it accepts the
# TCP connection but never sends an SSH banner, so ssh2 fails with "Timed out
# while waiting for handshake" after ~20s. That failure mode looks like a hang
# rather than a refusal, so if this ever starts timing out, check the port
# before suspecting credentials.
CI_SFTP_PORT=2282
CI_SFTP_USER=Five9reece
# Blank here — comes from the Five9 VCC config (getVCCConfiguration.
# recordingsServer) and lives in Railway env only. NOTE: this credential is
# SHARED with Five9's own recording push, so rotating it breaks the export as
# well as this pull. A dedicated read-only account is the PHASE 0.1 ask.
CI_SFTP_PASSWORD=
CI_SFTP_ROOT=/Five9/Recordings
# HARD GUARD. Anything other than the literal 'false' means read-only, and an
# unset value means read-only. nas1 is a third party's archive, the account
# has rwxrwxrwx over it, and it is the system of record for every recording we
# have — so this codebase lists and downloads, and never uploads, deletes, or
# renames. Do not "temporarily" flip this.
CI_SFTP_READONLY=true
# ─── worker (src/ci/worker.js) ──────────────────────────────────────────────
# Ships DISARMED. Stages 3–5 (transcribe/analyze/match/sync) are still stubs,
# so an armed worker would burn SFTP and storage on calls nothing can finish.
# Arm only once those PRs land.
CI_WORKER_ENABLED=false
# Tick interval for the internal loop; n8n's POST /ci/tick is the belt-and-
# suspenders trigger on top of this. Floor 30s.
CI_TICK_INTERVAL_MS=300000
# How long a claimed call stays leased before it becomes claimable again. A
# worker that dies mid-stage releases by expiry rather than stranding the call.
CI_WORKER_LEASE_SECONDS=300
# LP AddNotes note category. 1 is a PLACEHOLDER until Mark picks a dedicated
# "AI Call Note" category (PHASE 0.3) — harmless while writes are off.
LP_NOTE_CATEGORY_ID=1
# GroupMe bot for EXCEPTION alerts only (review backlog >20, reconciliation
# gaps, sync-failure spikes). No success alerts.
GROUPME_CI_BOT_ID=

# ─── post-send delivery reconciler (src/services/send-delivery-verify.js) ───
# Re-reads recently completed send_message actions against GHL message status
# and flips them to failed when GHL reports the message did not land.
# Never gates or delays a send. Set to "false" to disable.
SEND_VERIFY_ENABLED=
# Lag before a send is checked. GHL's message list propagates behind the send
# by up to a minute, so checking sooner produces false failures.
SEND_VERIFY_MIN_AGE_SEC=120
SEND_VERIFY_MAX_AGE_MIN=60
SEND_VERIFY_BATCH=25

# 2026-09-02 — agentic reply SLA (src/jobs/reply-sla-watchdog.js, fired from the
# decision-engine heartbeat). shadow = emit telemetry only; live = pages via
# AGENTIC_REPLY_SLA_ALERT; off = disabled.
REPLY_SLA_WATCHDOG_MODE=shadow
REPLY_SLA_MINUTES=10
REPLY_SLA_LOOKBACK_HOURS=24
# 2026-09-02 — send_message handler watchdog (generation + GHL send). See
# HANDLER_TIMEOUT_OVERRIDES_MS in src/actions/index.js.
EXECUTOR_SEND_MESSAGE_TIMEOUT_MS=120000

# 2026-09-02 — agentic email reply sender (src/send-message-handler.js
# resolveEmailSender). ONE narrow rule: when a lead replies TO Randy's
# broadcast mailbox, the reply goes out from the rep mailbox below instead of
# Randy's. Every other thread — a rep's own mailbox, contact@, info@,
# careers@, agreements@ — keeps v3.11/v3.14 sender continuity and replies from
# the mailbox the lead actually wrote to. Nothing else triggers the reroute:
# the thread-sender classifier picks the VOICE, never the sender.
#
# REPLY_FROM_EMAIL MUST be a sender verified in GHL's email provider, or GHL
# substitutes its default. REPLY_FROM_USER_ID is the rep's GHL user id
# (LC-Email keys From on it).
AGENTIC_REPLY_FROM_EMAIL=mark@getreecewindows.com
AGENTIC_REPLY_FROM_USER_ID=
# Randy's broadcast mailbox — matched EXACTLY, case-insensitive. Only set this
# if Randy's address ever changes; a prefix or domain rule is deliberately not
# used, so no other mailbox can be caught by it.
AGENTIC_RANDY_EMAIL=randy@getreecewindows.com

# ─── Data-freshness warehouse invariants (src/admin/data-freshness.js) ──────
# Accepted baseline for the LP prospect-split check: contacts whose lp_leads
# span more than one lp_prospect_id over the trailing 90 days. Measured
# 2026-09-04 = 161. The check alerts only ABOVE this number, so the accepted
# residual stays visible without paging.
#
# A RISE means the LeadAdd path is splitting prospects again — one human is
# being given two person-level identities. lp_prospect_id is the stable key
# used for cross-system lookups, so deleting the duplicate LEADS does not clean
# it up; the extra prospects must be merged or deleted in LP by a human. This
# check DETECTS ONLY and never auto-merges.
#
# Re-measure before changing this, the way JOB_DATE_INVERSION_BASELINE was
# pinned. Never raise it just to silence an alert.
FRESHNESS_PROSPECT_SPLIT_BASELINE=161

# ── 2026-09-04 — LP-driven source reconciler (src/jobs/source-reconcile.js) ──
# Daily 05:30 ET job that mirrors LP's authoritative source list into
# lp_source_catalog and diffs it against lp_source_mapping. Report-only: it
# NEVER creates a mapping — bucket and entry tag stay a human decision.
#
# Volume floor a gap must clear before it alerts, measured over the last 30
# days from v_source_volume_90d. An event nobody booked a lead from is not an
# alert; below this the source is still reported by get_source_catalog_health,
# it just stays quiet. Raise it to make the job quieter, never to hide work.
SOURCE_GAP_MIN_LEADS_30D=25
# Second, LOWER floor for event-class sources — those whose lp_source_raw
# matches "Events …" or contains "Show". Events are short-lived and low-volume
# by nature: a weekend home show produces a dozen leads total, so a 25-lead
# floor does not make them quiet, it makes them structurally invisible. This
# only ever lowers the bar; an event source above the standard floor still
# alerts. Idempotency is unchanged — one alert per source per ISO week.
SOURCE_GAP_MIN_LEADS_30D_EVENTS=5
# Kill switch for the daily job. false = scheduler never starts; the
# /api/lp/source-reconcile route and the MCP tools still work on demand.
#
# Railway is authoritative for this value. This file is documentation only —
# never read it to determine what production is doing.
SOURCE_RECONCILE_ENABLED=true

# ── Memory vector tier (priority #7, sql/094) ────────────────────────────────
# off (default) = full-text only | shadow = run both, log, return full-text |
# live = return the fused list. Flip shadow → live only after
# memory_vector_queries shows vector_only > 0 on relevant queries.
MEMORY_VECTOR_MODE=off
MEMORY_VECTOR_MIN_SIMILARITY=0.30
MEMORY_VECTOR_MATCH_COUNT=20

# ── Memory nightly job + boot check (priority #8) ────────────────────────────
MEMORY_NIGHTLY_ENABLED=true
MEMORY_NIGHTLY_HOUR_ET=3
# Boot check warns if sql/090–097 objects are missing; applies the files only when true.
MEMORY_MIGRATIONS_AUTOAPPLY=false
# Pending-item auto-close (sql/096). off | shadow | live — flip to shadow after
# deploy, live after Mark reviews would_close. Rules A–D + stale flag; the
# protected item_types (decision_needed, unconfirmed_decision, open_question,
# approval_needed) are never touched in any mode.
MEMORY_AUTOCLOSE_MODE=off
# Weekly GroupMe digest of items waiting on Mark (rule E), sent by the nightly
# run whose ET weekday matches MEMORY_DIGEST_WEEKDAY.
MEMORY_DIGEST_ENABLED=true
MEMORY_DIGEST_WEEKDAY=Monday

# ── Omi conversation ingest (sql/101) ────────────────────────────────────────
# Omi (Mark's wearable recorder) → n8n relay → POST /memory/omi/ingest. Every
# item it produces is an UNCONFIRMED proposal in claude_pending_items. No raw
# transcript is ever stored. Nothing is auto-promoted to a decision.
#
# off (default) = the route answers 503 | shadow = everything runs but only a
# claude_memory_validation_log row is written | live = memory rows are written.
# NEVER set live before sql/101 is applied and shadow output has been reviewed.
OMI_INGEST_MODE=off
# Bearer token n8n sends to LP-MCP. Its own secret on purpose — NOT
# MCP_AUTH_TOKEN. Generate 32 random bytes hex. Unset = every call is 401.
OMI_INGEST_TOKEN=
# The token in the Omi webhook URL (?token=…), relayed by n8n as X-Omi-Token.
# A second, different 32-byte value. Unset = every call is 401.
OMI_WEBHOOK_TOKEN=
# Comma-separated Omi user ids allowed to write to this memory. EMPTY REJECTS
# EVERYTHING and logs the rejected uid to claude_memory_validation_log as
# 'omi:uid_rejected' — that row is how Mark learns his uid on the first test.
OMI_ALLOWED_UIDS=
# Cosine at or above which an extracted item is the same as an OPEN pending
# item: no new row, the existing one gets an omi_mentions entry instead.
OMI_DEDUPE_THRESHOLD=0.90
# Extracted items below this model confidence are dropped before anything is written.
OMI_MIN_CONFIDENCE=0.5
# Transcript characters sent to the extractor (first 75% + last 25% when over).
OMI_MAX_TRANSCRIPT_CHARS=60000
# Request body cap. Also raises the JSON parser limit for /memory/omi only.
OMI_MAX_BODY_BYTES=2000000
# Per-uid requests per minute before 429.
OMI_RATE_LIMIT_PER_MIN=30
# Optional. The extraction model, read through src/llm-client.js's per-function
# rules for fn 'omi_extract' — so this var is the ANTHROPIC model id. To run it
# on OpenAI instead set OMI_EXTRACT_PROVIDER=openai and OMI_EXTRACT_MODEL_OPENAI.
# Unset = the llm-client default.
OMI_EXTRACT_MODEL=
# Reuses: MEMORY_CONFLICT_THRESHOLD (0.85), OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY.

# ─── Command Center recommendations (sql/102) ───────────────────────────────
# The nightly step and /admin/memory/recommend that put a verdict, a reason and
# the evidence onto each open Rulings-lane card. A recommendation is NEVER a
# ruling: it writes only the rec_* columns and nothing it produces closes a card
# or files a decision.
#   off     (default) nothing runs and nothing is spent.
#   shadow  the run happens; each result goes to claude_memory_validation_log as
#           'recommend:shadow'. The rec_* columns stay untouched, so the output
#           can be read before anyone trusts it.
#   live    the rec_* columns are written.
# Leave this off until sql/102 is applied. shadow first; live is a separate call.
MEMORY_RECOMMEND_MODE=off
# Cards per run. The queue's risk-first sort decides which ones, so a capped run
# still does the items that matter most.
MEMORY_RECOMMEND_MAX_PER_RUN=150
# Per-card ceiling: four lookups plus one LLM call. A card that overruns is
# skipped and logged; the batch carries on.
MEMORY_RECOMMEND_ITEM_TIMEOUT_MS=45000
# Optional. The model, read through src/llm-client.js's per-function rules for
# fn 'memory_recommend' — so this var is the ANTHROPIC model id. To run it on
# OpenAI instead set MEMORY_RECOMMEND_PROVIDER=openai and
# MEMORY_RECOMMEND_MODEL_OPENAI. Unset = the decision_engine group's model.
MEMORY_RECOMMEND_MODEL=
# Reuses: MEMORY_CONFLICT_THRESHOLD (0.85), MCP_AUTH_TOKEN (the admin routes).

# Estimate PDF link (kb-retriever v1.13)
REECE_TRIGGER_ESTIMATE_PDF=uyGlZ6ydYUmAqeWysREJ   # GHL "View Calculator Estimate" trigger link
ESTIMATE_LINK_GUARD=on                             # send-time guard; set "off" to disable
