# Lead Perfection API — OAuth2 Password Grant
# The LP API uses token-based auth, NOT a simple API key.
# Base URL: https://{LP_SERVER_ID}.leadperfection.com
LP_SERVER_ID=api
LP_CLIENT_ID=
LP_USERNAME=
LP_PASSWORD=
LP_APP_KEY=

# Legacy — only use if LP_SERVER_ID doesn't apply (overrides server ID)
# LP_API_BASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel
GHL_API_KEY=

# MCP Server
MCP_AUTH_TOKEN=
PORT=3000

# Webhook (optional — validates incoming LP webhook payloads)
N8N_WEBHOOK_SECRET=
