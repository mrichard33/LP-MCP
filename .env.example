# ─── Lead Perfection API (v5.0) ───────────────────────────────────
# Auth: JWT token via POST /token (expires 24hr, auto-refreshed every 23hr)
# All endpoints are POST with Content-Type: application/x-www-form-urlencoded
#
# IMPORTANT: Token is path-specific — only valid on the server it was generated on.
# Confirm which server the Reece account uses before setting LP_API_BASE_URL.

# Production server URL (one of these):
#   https://api.leadperfection.com   (Production 1 — most common)
#   https://api2.leadperfection.com  (Production 2)
#   https://api3.leadperfection.com  (Production 3)
#   https://apitest.leadperfection.com  (Test — for development only)
LP_API_BASE_URL=

# LP user account with APISECURITY permissions enabled
LP_USERNAME=

# LP user account password
LP_PASSWORD=

# Company subdomain code — NOT the username.
# If LP login URL is xx00.leadperfection.com, ClientID = xx00
LP_CLIENT_ID=

# GUID issued by RJR Technology — unique per integration
# Obtain from LP account management if not already issued
LP_APP_KEY=

# ─── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GoHighLevel ──────────────────────────────────────────────────
GHL_API_KEY=

# ─── GHL Inbound → LP Note pipeline (src/ghl-note-pipeline) ───────
# Turns GHL inbound conversations into one clean facts-only LP note per
# conversation session for the call center. GHL-only, independent of Revin.
# Reuses GHL_API_KEY, GHL_LOCATION_ID, HL_SUPABASE_URL/_SERVICE_ROLE_KEY,
# ANTHROPIC_API_KEY, GROUPME_BOT_ID, SUPABASE_* and LP_* creds.
WEBHOOK_GHL_INBOUND_TOKEN=         # same secret set in the GHL webhook X-Webhook-Token header
GHL_NOTE_MODE=shadow               # off | shadow | live  (deploy as shadow)
LP_NOTE_REP_ID=                    # informational AI-brief identity (AddNotes has no rep_id field)
GHL_NOTE_CATEGORY_ID=1             # LP note category (nct_id) for standard notes
GHL_NOTE_IMPORTANT_CATEGORY_ID=    # LP note category (nct_id) for important notes; blank = use standard
GHL_NOTE_DEBOUNCE_MIN=30
GHL_NOTE_SWEEP_SEC=90
GHL_NOTE_RECON_MIN=30
GHL_NOTE_STALE_CLAIM_MIN=15
GHL_NOTE_MAX_ATTEMPTS=5
GHL_NOTE_TEXT_TYPES=2,3,5,11,18,29 # allowlisted channels (GHL numeric message types)
GHL_NOTE_DROP_TYPES=1,45           # calls + reactions
# Optional per-function model override for the summarizer (default claude-sonnet-4-6):
# GHL_NOTE_SUMMARIZER_MODEL_ANTHROPIC=claude-sonnet-4-6

# ─── Lead Gurus (I.LG — paid-media ingest, src/leadgurus-ingest.js) ──
# Paid-media agency platform (clients.leadgurus.com). Header X-API-Key.
LEAD_GURUS_API_KEY=
LEAD_GURUS_CLIENT_ID=91
# Contact enrichment is OFF until all 5 GHL custom-field IDs exist AND this is
# 'true'. Leave disabled until Mark creates the ft_* fields and captures IDs.
LEAD_GURUS_ENRICH_ENABLED=false
GHL_CF_FT_CAMPAIGN_ID=
GHL_CF_FT_CREDIT_SCORE=
GHL_CF_FT_PROJECT_TYPE=
GHL_CF_FT_SELF_BOOK_DT=
GHL_CF_FT_TERRITORY=

# ─── Anthropic API (for Response Generator) ──────────────────────
# Used by src/response-generator.js to generate Antifragile responses
ANTHROPIC_API_KEY=

# ─── OpenAI API (for KB embeddings) ──────────────────────────────
# Used by src/knowledge/openai-embeddings.js for text-embedding-3-small
# Required for vector search across the kb_embeddings table.
# Cost: ~$0.02 per 1M input tokens. Each response generation = ~1 embed.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── MCP Server ───────────────────────────────────────────────────
MCP_AUTH_TOKEN=
PORT=3000

# ─── Context Builder ─────────────────────────────────────────────
# In-memory context cache TTL (ms). Default 60000 (1 min). Was 5 min.
# Lower value reduces stale-data risk when other callers hit the cache.
CONTEXT_CACHE_TTL_MS=60000

# Threshold (minutes) above which lp_lead.synced_at is flagged stale
# for active dispositions. Lower = more LP refreshes, higher = more risk.
LP_DATA_STALE_THRESHOLD_MIN=15

# ─── Infrastructure Admin (v5.1) ─────────────────────────────────
# Railway API — project-scoped token from Railway dashboard
RAILWAY_API_TOKEN=
# Railway service ID for the LP MCP service
RAILWAY_SERVICE_ID=
# GitHub PAT — repo scope on LP MCP repository
GITHUB_PAT=
# GitHub repo path (org/repo format, e.g. 'reece-windows/lp-mcp-server')
GITHUB_REPO=

# ─── Webhook (optional) ───────────────────────────────────────────
N8N_WEBHOOK_SECRET=

# ─── Agentic cooling callbacks ───────────────────────────────────
# Token used by the GHL I.COOL-* workflows when POSTing cooling callbacks
# to /agentic/cooling/complete and /agentic/cooling/error.
# Set the SAME value in GHL custom_values.message_engine_token.
# Falls back to MESSAGE_ENGINE_TOKEN if unset.
AGENTIC_CALLBACK_TOKEN=

# ─── Agentic reply dispatcher (2026-07-03 rebuild, Steve Nkzhm incident) ──
# Master switch for direct agentic sends via the GHL Conversations API with
# channel + identity inherited from the triggering inbound (Live_Chat stays
# in the widget; SMS replies from the exact number the customer texted).
# 'false' = instant rollback to the legacy relay-workflow webhook path
# (requires GHL workflow 497e664a still published). Default: true.
AGENTIC_DIRECT_SEND=true
# A livechat inbound older than this many minutes is treated as a closed
# widget session and downgraded to SMS (when the contact has a phone).
LIVECHAT_SESSION_TTL_MIN=15
# Minimum gap between agentic sends to one contact. A reply that becomes
# ready inside the gap is rescheduled and re-checks supersession first.
MIN_AGENTIC_SEND_GAP_SEC=90
# An in_flight agentic reply slot older than this is treated as a crashed
# holder and reclaimed at the next acquire.
LOCK_TTL_SEC=120

# ─── LP Contact Auto-Create Backstop ─────────────────────────────
# Flag-gated 15-min sweep: finds-or-creates the GHL contact for unlinked LP
# leads with an upcoming Set/Cnf/Verif appointment (I.LP-IN webhook delivery
# misses ~30% of them), then reconciles the appointment. When not 'true' the
# scheduler no-ops; the admin endpoint POST /admin/lp-contact-backstop still
# works (dry-run default) for verification. Flip to true on Railway only after
# a reviewed dry-run.
ENABLE_LP_CONTACT_BACKSTOP=false
# Safety cap: max contacts created/linked per sweep run (excess carries to the
# next run — the scan self-heals as ghl_contact_id fills in).
LP_CONTACT_BACKSTOP_MAX_PER_RUN=50

# ─── Agentic Appointment Notifications (v1) ──────────────────────
# Feature flag for /api/agentic/notifications/appointment. When not
# 'true', the endpoint returns 503 and the GHL workflow's 30-min
# timeout fires the legacy fallback notification path.
ENABLE_ENHANCED_APPT_NOTIFICATIONS=false

# GHL custom field IDs for the team notification gate. Capture these
# from the GHL UI after creating the four custom fields:
#   Team Notification Body   — Multi-line text   (long-form email body)
#   Team Notification SMS    — Single-line text  (short-form SMS body)
#   Team Notification ID     — Single-line text
#   Team Notification Ready  — Single-option (Yes / No)
GHL_FIELD_TEAM_NOTIFICATION_BODY=
GHL_FIELD_TEAM_NOTIFICATION_SMS=
GHL_FIELD_TEAM_NOTIFICATION_ID=
GHL_FIELD_TEAM_NOTIFICATION_READY=

# Optional model override (defaults to claude-sonnet-4-5, falls back
# to NURTURE_GENERATOR_MODEL).
APPT_NOTIFICATION_MODEL=
APPT_NOTIFICATION_MAX_TOKENS=700
APPT_NOTIFICATION_TIMEOUT_MS=8000
APPT_NOTIFICATION_TEMPERATURE=0.4
APPT_NOTIFICATION_CONTEXT_TIMEOUT_MS=4000
APPT_NOTIFICATION_GHL_TIMEOUT_MS=10000
APPT_NOTIFICATION_EMAIL_CAP=1500
APPT_NOTIFICATION_SMS_CAP=300

# ─── IME MIC (Sam's Club Construction leads) ─────────────────────
# Reece is the affiliate provider for Sam's Club Construction leads.
# IME tokens expire in 30 minutes — refreshed automatically by src/ime/token-manager.js.
# All /ime/* routes use MCP_AUTH_TOKEN for auth.
IME_AFFILIATE_ID=17050371
IME_USERNAME=
IME_PASSWORD=
IME_BASE_URL_UAT=https://imewebapiexternal-uat.azurewebsites.net
IME_BASE_URL_PROD=
IME_ENV=uat                         # flip to "prod" after UAT validation
IME_TOKEN_REFRESH_BUFFER_MIN=5      # refresh 5 min before expiry
IME_RETRY_MAX=5                     # max retries per enrichment
IME_RETRY_INTERVAL_MIN=5            # retry-cron interval
IME_REQUEST_TIMEOUT_MS=15000        # per-call timeout

# ─── Map-Driven Entry Routing (routing fix, Step 2) ──────────────
# When 'true', lead entry-routing reads lp_source_mapping (granular
# source → correct entry tag + intent bucket) instead of letting the
# 6 coarse hygiene rules blanket-stamp entry:other. Gates BOTH the
# inferEntrySource Priority-0 safety net and the contact_created
# resolver. Default false = byte-for-byte current behavior.
ENTRY_RESOLVER_MAP_DRIVEN=false
# Optional: in-memory TTL (ms) for the cached lp_source_mapping table.
ENTRY_SOURCE_MAP_TTL_MS=300000

# ─── Revenue Scorecard (src/jobs/scorecard-metrics.js, goal-scorecard-daily.js) ──
# All optional — defaults below preserve current behavior. ⚠ TIE-OUT: calibrate the
# status sets against a real Reece "By Appt Date" export, then set
# SCORECARD_RECONCILED_MARKETS=REECE to flip the dashboard out of PROVISIONAL.
#
# Sold-deal job statuses RELEASED to production → counted as Net Sales.
SCORECARD_RELEASED_STATUSES=Rel To Production,RTP Await recission,RTP DP DUE,Awaiting Product
# Sold-deal job statuses HELD pre-release (financing/HOA/docs/measure) → Working Revenue.
SCORECARD_WORKING_STATUSES=HOLD - HOA,HOLD-Shutter Approval,Mgmt Hold,Awaiting Credit Application,Awaiting Lender,Awaiting Loan Docs,Awaiting Change Order,Awaiting Commission Sheet,Awaiting Paperwork,Out to Measure
# Sat dispositions EXCLUDED from the demo count (real LP labels: NOC=No Contact, NIS=Not Interested - Shown).
SCORECARD_NON_DEMO_DISPOSITIONS=NOC,NIS
# (existing) Job statuses counted as KO / cancelled (drive the "Net" columns).
SCORECARD_CANCEL_STATUSES=Cancelled,Cancelled By Mgt,Dead Deal,Credit Decline
# (existing) Comma-separated markets confirmed reconciled → flips reconciled=true (default: none = provisional).
SCORECARD_RECONCILED_MARKETS=
# NIGHTLY live-month funnel attribution: 'true' attributes the daily scorecard
# branch-first (lp_lead_market_assignments, matching revenue); anything else (default)
# keeps the legacy prospect-ZIP attribution. OFF by default so a deploy is INERT until
# flipped — the closed-month re-derive (POST /n8n/admin/scorecard-market-rederive)
# always measures branch-first regardless of this flag, so the gate can be verified
# before the live-month behavior is switched on.
SCORECARD_BRANCH_FIRST_ATTRIBUTION=
# Selling-day calendar (src/selling-days.js) — drives days_elapsed (numerator) and
# working_days_in_period (denominator) on each snapshot. Must match the dashboard's
# SCORECARD_SELLING_DAYS / SCORECARD_HOLIDAYS so writer and reader share one basis.
SCORECARD_SELLING_DAYS=mon,tue,wed,thu,fri,sat
# Non-selling days: comma-separated YYYY-MM-DD, or "none". Default (empty) = Reece
# closures (New Year's, Jul 4, Thanksgiving, Christmas) — NOT the federal calendar.
SCORECARD_HOLIDAYS=
