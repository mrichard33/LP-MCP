# ─── Lead Perfection API (v5.0) ───────────────────────────────────
# Auth: JWT token via POST /token (expires 24hr, auto-refreshed every 23hr)
# All endpoints are POST with Content-Type: application/x-www-form-urlencoded
#
# IMPORTANT: Token is path-specific — only valid on the server it was generated on.
# Confirm which server the Reece account uses before setting LP_API_BASE_URL.

# Production server URL (one of these):
#   https://api.leadperfection.com   (Production 1 — most common)
#   https://api2.leadperfection.com  (Production 2)
#   https://api3.leadperfection.com  (Production 3)
#   https://apitest.leadperfection.com  (Test — for development only)
LP_API_BASE_URL=

# LP user account with APISECURITY permissions enabled
LP_USERNAME=

# LP user account password
LP_PASSWORD=

# Company subdomain code — NOT the username.
# If LP login URL is xx00.leadperfection.com, ClientID = xx00
LP_CLIENT_ID=

# GUID issued by RJR Technology — unique per integration
# Obtain from LP account management if not already issued
LP_APP_KEY=

# ─── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── GoHighLevel ──────────────────────────────────────────────────
GHL_API_KEY=

# ─── Anthropic API (for Response Generator) ──────────────────────
# Used by src/response-generator.js to generate Antifragile responses
ANTHROPIC_API_KEY=

# ─── OpenAI API (for KB embeddings) ──────────────────────────────
# Used by src/knowledge/openai-embeddings.js for text-embedding-3-small
# Required for vector search across the kb_embeddings table.
# Cost: ~$0.02 per 1M input tokens. Each response generation = ~1 embed.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── MCP Server ───────────────────────────────────────────────────
MCP_AUTH_TOKEN=
PORT=3000

# ─── Context Builder ─────────────────────────────────────────────
# In-memory context cache TTL (ms). Default 60000 (1 min). Was 5 min.
# Lower value reduces stale-data risk when other callers hit the cache.
CONTEXT_CACHE_TTL_MS=60000

# Threshold (minutes) above which lp_lead.synced_at is flagged stale
# for active dispositions. Lower = more LP refreshes, higher = more risk.
LP_DATA_STALE_THRESHOLD_MIN=15

# ─── Infrastructure Admin (v5.1) ─────────────────────────────────
# Railway API — project-scoped token from Railway dashboard
RAILWAY_API_TOKEN=
# Railway service ID for the LP MCP service
RAILWAY_SERVICE_ID=
# GitHub PAT — repo scope on LP MCP repository
GITHUB_PAT=
# GitHub repo path (org/repo format, e.g. 'reece-windows/lp-mcp-server')
GITHUB_REPO=

# ─── Webhook (optional) ───────────────────────────────────────────
N8N_WEBHOOK_SECRET=

# ─── Agentic cooling callbacks ───────────────────────────────────
# Token used by the GHL I.COOL-* workflows when POSTing cooling callbacks
# to /agentic/cooling/complete and /agentic/cooling/error.
# Set the SAME value in GHL custom_values.message_engine_token.
# Falls back to MESSAGE_ENGINE_TOKEN if unset.
AGENTIC_CALLBACK_TOKEN=

# ─── IME MIC (Sam's Club Construction leads) ─────────────────────
# Reece is the affiliate provider for Sam's Club Construction leads.
# IME tokens expire in 30 minutes — refreshed automatically by src/ime/token-manager.js.
# All /ime/* routes use MCP_AUTH_TOKEN for auth.
IME_AFFILIATE_ID=17050371
IME_USERNAME=
IME_PASSWORD=
IME_BASE_URL_UAT=https://imewebapiexternal-uat.azurewebsites.net
IME_BASE_URL_PROD=
IME_ENV=uat                         # flip to "prod" after UAT validation
IME_TOKEN_REFRESH_BUFFER_MIN=5      # refresh 5 min before expiry
IME_RETRY_MAX=5                     # max retries per enrichment
IME_RETRY_INTERVAL_MIN=5            # retry-cron interval
IME_REQUEST_TIMEOUT_MS=15000        # per-call timeout
